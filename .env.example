# =============================================================================
# Sytue One — variables de entorno (PLANTILLA RAÍZ)
#
# Copia a `.env` y rellena con valores LOCALES de desarrollo:
#   cp .env.example .env
#
# REGLAS (docs/CONVENTIONS.md §10, docs/security.md#1-seguridad-y-rgpd):
#   - Estos son PLACEHOLDERS. NUNCA pongas secretos reales de producción aquí.
#   - `.env` está en .gitignore y JAMÁS debe subirse a git.
#   - En PROD los secretos viven en Scaleway Secret Manager + Sealed Secrets,
#     se inyectan como variables de entorno / Secrets de k8s, no en este fichero.
#   - 100 % UE: solo regiones Scaleway de la UE (fr-par principal, nl-ams DR).
#
# STACK: Go + Astro/Preact + PostgreSQL (estado/colas/caché) + S3 (blobs).
#   SIN Redis/Valkey. SIN motores AGPL (Keycloak/Nextcloud/OnlyOffice/Mattermost/
#   Stalwart eliminados). Única app de terceros: LiveKit (SFU de Sytue Meet).
#
# El entorno DEV (Docker Compose) usa además deploy/compose/.env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Entorno y dominios
# -----------------------------------------------------------------------------
SYTUE_ENV= # dev | staging | prod
# Dominio público de prod (en dev se usa *.sytue.localhost vía Traefik/mkcert).
SYTUE_DOMAIN=
SYTUE_DOMAIN_DEV=
# Dominio de la cookie de sesión única (BFF, httpOnly). En dev: .sytue.localhost
SYTUE_COOKIE_DOMAIN=

# Subdominios de ejecución del PaaS (Sytue Cloud)
SYTUE_APPS_DOMAIN= # <app>.apps.sytue.eu (prod)
SYTUE_PREVIEW_DOMAIN= # <proyecto>-pr-<n>.preview.sytue.eu
SYTUE_INGRESS_HOST= # destino CNAME de dominios propios

# -----------------------------------------------------------------------------
# 2) Scaleway (cloud, SOLO regiones UE) — PROD/IaC
#    Credenciales reales SOLO por entorno / Secret Manager, nunca en git.
# -----------------------------------------------------------------------------
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_REGION= # región principal UE
SCW_DEFAULT_ZONE=
SCW_DR_REGION= # región de recuperación ante desastres (UE)

# Backend de estado de Terraform (Object Storage S3 Scaleway, bucket versionado)
TF_STATE_BUCKET=
TF_STATE_REGION=

# Registro de contenedores Scaleway (UE) para imágenes de los servicios Go.
SCW_REGISTRY_ENDPOINT=
SCW_REGISTRY_NAMESPACE_PLATFORM=
SCW_REGISTRY_NAMESPACE_PAAS=

# -----------------------------------------------------------------------------
# 3) Sytue ID — IdP NUCLEAR (servicio Go propio: OIDC/OAuth2/PKCE/JWKS/SCIM/MFA)
#    Cada servicio Go valida los JWT de Sytue ID vía JWKS local.
# -----------------------------------------------------------------------------
# Issuer OIDC (prod: https://id.sytue.eu; dev: https://id.sytue.localhost).
OIDC_ISSUER=
OIDC_JWKS_URL=
# BD de Sytue ID (un servicio = una BD/rol en Postgres).
ID_DB_NAME=
ID_DB_USER=
ID_DB_PASSWORD=
SYTUE_ID_DATABASE_URL=

# -----------------------------------------------------------------------------
# 4) OIDC — secretos de clients confidenciales (BFF por superficie)
#    Un client por superficie + el client del PaaS API. (Ya NO hay clients de
#    federación de motores: no hay motores.)
# -----------------------------------------------------------------------------
OIDC_SYTUE_ONE_CLIENT_SECRET=
OIDC_SYTUE_CONSOLE_CLIENT_SECRET=
OIDC_SYTUE_CLOUD_CLIENT_SECRET=
OIDC_SYTUE_CLOUD_API_CLIENT_SECRET=
OIDC_SYTUE_MAIL_CLIENT_SECRET=
OIDC_SYTUE_DRIVE_CLIENT_SECRET=
OIDC_SYTUE_CALENDAR_CLIENT_SECRET=
OIDC_SYTUE_CONTACTS_CLIENT_SECRET=
OIDC_SYTUE_DOCS_CLIENT_SECRET=
OIDC_SYTUE_CHAT_CLIENT_SECRET=
OIDC_SYTUE_MEET_CLIENT_SECRET=
OIDC_SYTUE_HUB_CLIENT_SECRET=

# Secreto para cifrar/firmar la cookie de sesión del BFF (JWE/JWS, >= 32 chars)
SYTUE_SESSION_SECRET=

# -----------------------------------------------------------------------------
# 5) PostgreSQL 16 — DATASTORE ÚNICO (estado + colas + caché). Una BD/rol por
#    servicio Go. Prod: Scaleway RDB (endpoint privado, TLS). Sin Redis/Valkey.
# -----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# DATABASE_URL por servicio Go (el servicio lee la suya como DATABASE_URL).
DRIVE_DB_NAME=
DRIVE_DB_USER=
DRIVE_DB_PASSWORD=
SYTUE_DRIVE_DATABASE_URL=

DOCS_DB_NAME=
DOCS_DB_USER=
DOCS_DB_PASSWORD=
SYTUE_DOCS_DATABASE_URL=

MAIL_DB_NAME=
MAIL_DB_USER=
MAIL_DB_PASSWORD=
SYTUE_MAIL_DATABASE_URL=

CALENDAR_DB_NAME=
CALENDAR_DB_USER=
CALENDAR_DB_PASSWORD=
SYTUE_CALENDAR_DATABASE_URL=

CONTACTS_DB_NAME=
CONTACTS_DB_USER=
CONTACTS_DB_PASSWORD=
SYTUE_CONTACTS_DATABASE_URL=

NOTES_DB_NAME=
NOTES_DB_USER=
NOTES_DB_PASSWORD=
SYTUE_NOTES_DATABASE_URL=

# SyERP (:8098). SYERP_SECRET_ENC_KEY sella el secreto de firma de los webhooks
# de Stripe (AES-256 en base64, 32 bytes); sin ella no se puede configurar
# ninguno, que es mejor que guardarlo en claro. En dev puede quedarse vacía.
# Generar con:
#   openssl rand -base64 32
SYERP_DB_NAME=
SYERP_DB_USER=
SYERP_DB_PASSWORD=
SYTUE_SYERP_DATABASE_URL=
SYERP_SECRET_ENC_KEY=

CHAT_DB_NAME=
CHAT_DB_USER=
CHAT_DB_PASSWORD=
SYTUE_CHAT_DATABASE_URL=

MEET_DB_NAME=
MEET_DB_USER=
MEET_DB_PASSWORD=
SYTUE_MEET_DATABASE_URL=

HUB_DB_NAME=
HUB_DB_USER=
HUB_DB_PASSWORD=
SYTUE_HUB_DATABASE_URL=

# BD del control plane de Sytue Cloud (PaaS / DB Studio sobre PostgREST)
CLOUD_DB_NAME=
CLOUD_DB_USER=
CLOUD_DB_PASSWORD=
# Sytue Analytics: base propia (analitica web anonima, ADR 0026).
ANALYTICS_DB_PASSWORD=
# KEK AES-256 en base64 con la que se cifra la SAL DIARIA en reposo. VACIA = la
# sal se guarda en claro y un volcado de PostgreSQL basta para recalcular los
# hashes del dia, que es justo lo que el cifrado impide. Generar con:
#   openssl rand -base64 32
SYTUE_ANALYTICS_KEY_ENCRYPTION_KEY=
SYTUE_CLOUD_DATABASE_URL=

# -----------------------------------------------------------------------------
# 6) Object Storage S3 — Scaleway en prod / MinIO en dev. Blobs por servicio,
#    aislados por prefijo de tenant (tenants/<slug>/).
# -----------------------------------------------------------------------------
S3_ENDPOINT= # dev MinIO: http://minio:9000
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DRIVE=
S3_BUCKET_DOCS=
S3_BUCKET_MAIL=
S3_BUCKET_BACKUPS=
S3_BUCKET_BUILD_CACHE=
# MinIO (solo dev)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# 7) Sytue Meet — LiveKit (SFU de medios WebRTC, Apache-2.0; única app de terceros)
#    El BFF de Meet (servicio Go) firma con este par el JWT de acceso a la sala
#    TRAS validar la sesión OIDC contra Sytue ID. El api_secret nunca sale del server.
# -----------------------------------------------------------------------------
LIVEKIT_URL= # dev: ws://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# 8) Sytue Mail — correo Sytue-native (servidor Go SMTP/IMAP/JMAP).
#    Selector y clave pública DKIM (la PRIVADA nunca va en git ni en DNS).
# -----------------------------------------------------------------------------
MAIL_HOSTNAME=
DKIM_SELECTOR=
DKIM_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# 9) Sytue Cloud (PaaS) — control plane Go: api :8090, builder :8091
# -----------------------------------------------------------------------------
CLOUD_API_PORT=
CLOUD_BUILDER_PORT=
# Clave de cifrado en reposo de secretos/credenciales de servicios (AES-256-GCM, 32 bytes).
SECRET_ENC_KEY=
# Secreto de verificación de webhooks Git (push -> prod, PR -> preview).
GIT_WEBHOOK_SECRET=
# PostgREST (API REST automática de Sytue Postgres / DB Studio)
POSTGREST_ROLE=
POSTGREST_ROLE_PASSWORD=
POSTGREST_JWT_SECRET=
