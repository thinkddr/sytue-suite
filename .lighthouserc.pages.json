{
  "ci": {
    "collect": {
      "staticDistDir": "apps/frontend/packages/pages-render/.lighthouse-pages",
      "url": [
        "http://localhost/_fixtures/academia/es/index.html",
        "http://localhost/_fixtures/alojamiento/es/index.html",
        "http://localhost/_fixtures/blanco/es/index.html",
        "http://localhost/_fixtures/clinica/es/index.html",
        "http://localhost/_fixtures/fabrica/es/index.html",
        "http://localhost/_fixtures/portfolio/es/index.html",
        "http://localhost/_fixtures/producto/es/index.html",
        "http://localhost/_fixtures/reformas/es/index.html",
        "http://localhost/_fixtures/restaurante/es/index.html",
        "http://localhost/_fixtures/servicios/es/index.html",
        "http://localhost/_fixtures/tienda/es/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "document-title": ["error", { "minScore": 1 }],
        "meta-description": ["error", { "minScore": 1 }],
        "canonical": ["error", { "minScore": 1 }],
        "is-crawlable": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/pages-reports"
    }
  }
}
