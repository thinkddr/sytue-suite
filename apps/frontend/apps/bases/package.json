{
  "name": "@sytue/bases",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue Bases — tablas relacionales colaborativas (Astro 7 + Preact 10). Bases, tablas, campos tipados, rejilla editable, vistas, permisos y conector de solo lectura. docs/CONVENTIONS.md §1; ADR 0068.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --port 4337 --host",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --port 4337 --host",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "@sytue/api-clients": "workspace:*",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/scripts": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "astro": "catalog:",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@happy-dom/global-registrator": "20.14.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
