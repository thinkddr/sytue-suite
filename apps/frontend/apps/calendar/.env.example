# Sytue Calendar — variables de entorno (ejemplo). Copiar a .env en dev.
# NUNCA secretos reales en git: en prod vienen de Scaleway Secret Manager /
# Sealed Secrets. Solo placeholders aqui. docs/CONVENTIONS.md §8, §10.

# --- OIDC (Sytue ID, client confidencial sytue-calendar) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

SYTUE_SESSION_SECRET=

# --- Backends (UE): servicio Go propio Sytue Calendar (CalDAV + REST) ---
# Servicio Go Sytue Calendar (dev 8087, docs/CONVENTIONS.md §6).
SYTUE_CALENDAR_BASE_URL=

# Sytue Notepads: referencia bidireccional evento <-> nota. La ficha del evento
# pregunta que notas cuelgan de el (API interna) y enlaza a la app (host publico).
# Si se dejan vacias, la seccion de notas simplemente no aparece.
SYTUE_NOTES_API_URL=
PUBLIC_SYTUE_NOTES_BASE_URL=
SYTUE_HUB_BASE_URL=
