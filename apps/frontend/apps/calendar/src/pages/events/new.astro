---
/**
 * Sytue Calendar — compositor de evento por deep-link (intent «crear evento desde
 * correo», docs/CONVENTIONS.md §11). El Hub compone esta URL con el evento
 * prerellenado en la query (action=create&title=…&description=…&start=…&attendees=…);
 * monta la MISMA isla CalendarApp que la vista principal, que lee y sanea la query
 * al montar y abre el modal de creación. SSR: el layout exige sesión.
 */
import { returnToCanonico } from '@sytue/config';
import AppLayout from '../../layouts/AppLayout.astro';
import { useT } from '../../i18n/index.js';
import { serverEnv } from '@sytue/auth/server';
import { CalendarApp } from '../../components/CalendarApp.js';
import { bff, toBffContext } from '../../lib/bff.js';

export const prerender = false;

const session = await bff.getSession(toBffContext(Astro));
if (!session) {
  // ADR 0056: la entrada org-ful llega reescrita con la marca ?__org=; el returnTo
  // sale canónico, no en la forma interna, o tras el login la barra se queda con ella.
  const returnTo = returnToCanonico(Astro.url, bff.basePath);
  const redireccionLogin = Astro.redirect(
    `${bff.basePath}/auth/login?returnTo=${encodeURIComponent(returnTo)}`,
  );
  redireccionLogin.headers.set('cache-control', 'no-store');
  return redireccionLogin;
}
const hubBaseUrl = serverEnv(import.meta.env).SYTUE_HUB_BASE_URL ?? 'https://hub.sytue.eu';
const t = useT(Astro.locals.locale);
---

<AppLayout title={t('page.newEventTitle')}>
  <CalendarApp
    slot="app"
    client:load
    locale={Astro.locals.locale}
    user={session.user}
    hubBaseUrl={hubBaseUrl}
  />
</AppLayout>
