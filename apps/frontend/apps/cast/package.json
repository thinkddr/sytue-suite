{
  "name": "@sytue/cast",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue Cast — vídeo bajo demanda y en directo (Astro 7 + Preact 10) sobre el servicio Go propio Sytue Cast. Portada pública, canal por organización, reproductor HLS, directo por WebRTC, chat, comentarios e incrustado. Monta la Sytue Shell y usa @sytue/ui. Producto Sytue-native, propietario. docs/CONVENTIONS.md §1.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --port 4335 --host",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --port 4335 --host",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "astro": "catalog:",
    "hls.js": "1.7.3",
    "livekit-client": "2.22.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
