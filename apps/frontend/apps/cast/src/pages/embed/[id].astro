---
/**
 * Sytue Cast — /embed/<id>, el reproductor para un `<iframe>` ajeno. Sin sesión,
 * sin Shell y solo lo público o no listado: la ficha se pide SIEMPRE por la ruta
 * pública, aunque quien mira tenga sesión, para que un vídeo privado no se pueda
 * incrustar con la cookie de quien lo abre. Esta es la única ruta de la app que se
 * deja encuadrar (`frame-ancestors *`, ver `lib/cabeceras.ts`).
 */
import '../../styles/app.css';
import { SUFIJO_ICONOS, withBase } from '@sytue/ui';
import { htmlLangAttrs } from '@sytue/i18n';
import { serverEnv } from '@sytue/auth/server';
import { EmbedApp } from '../../islands/EmbedApp.js';
import { consultar } from '../../lib/servicio.js';
import { RE_UUID } from '../../lib/pagina.js';
import type { Video } from '../../lib/tipos.js';

export const prerender = false;

const id = Astro.params.id ?? '';
if (!RE_UUID.test(id)) return new Response(null, { status: 404 });
const r = await consultar<Video>(`/api/v1/public/videos/${id}`);
if (!r.ok) Astro.response.status = r.status === 404 ? 404 : 503;
const v = r.ok ? r.datos : null;
const { lang, dir } = htmlLangAttrs(Astro.locals.locale);
const prefijo = serverEnv(import.meta.env).SYTUE_BASE_PATH ?? import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} dir={dir} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{v ? v.title : 'Sytue Cast'}</title>
    <link
      rel="icon"
      href={withBase(prefijo, '/favicon.svg') + SUFIJO_ICONOS}
      type="image/svg+xml"
    />
  </head>
  <body class="h-full bg-black">
    <EmbedApp client:load locale={Astro.locals.locale} video={v} />
  </body>
</html>
