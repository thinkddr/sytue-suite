---
/**
 * Sytue Cast — /moderation: «Denuncias y bloqueos». Exige sesión. Cualquiera ve a
 * quién tiene bloqueado; quien administra la organización, además, la cola de
 * denuncias y los bloqueos de toda ella.
 */
import AppLayout from '../layouts/AppLayout.astro';
import { ModerationApp } from '../islands/ModerationApp.js';
import { alLogin, hubBaseUrl, sesionDe } from '../lib/pagina.js';
import { useT } from '../i18n/index.js';

export const prerender = false;

const session = await sesionDe(Astro);
// El redirect en una constante: el comprobador de Astro no ve lo que va tras `return`.
const redireccion = session ? null : alLogin(Astro);
if (redireccion || !session) return redireccion;
const t = useT(Astro.locals.locale);
---

<AppLayout title={`${t('nav.moderation')} · ${t('app.title')}`}>
  <ModerationApp
    slot="app"
    client:load
    locale={Astro.locals.locale}
    user={session.user}
    hubBaseUrl={hubBaseUrl()}
  />
</AppLayout>
