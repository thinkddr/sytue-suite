{
  "name": "@sytue/app-cloud-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue DevX — dashboard del PaaS (Vercel x Supabase x Google Cloud, mas simple que Google Cloud). Astro 7 + Preact 10. Deploys, dominios, env/secrets, logs y Sytue DB Studio. Monta @sytue/shell y usa @sytue/ui. Producto Sytue-native, propietario. cloud.sytue.eu.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4323",
    "build": "astro build",
    "preview": "astro preview --port 4323",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sytue/api-clients": "workspace:*",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "astro": "catalog:",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
