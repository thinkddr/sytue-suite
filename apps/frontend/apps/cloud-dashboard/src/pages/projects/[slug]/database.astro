---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DbStudio from '../../../components/db/DbStudio';
import type { DbRows } from '../../../lib/types.js';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../../../server/bff.js';
import {
  firstSourceError,
  loadProject,
  loadDbTables,
  loadDbRows,
  loadDbApiInfo,
  loadPostgresService,
} from '../../../lib/cloud.js';

import { useT } from '../../../i18n/index.js';

export const prerender = false;

// El idioma lo negocia el middleware una vez por peticion y baja a la isla por
// props: detectarlo en el cliente desajustaria la hidratacion.
const locale = Astro.locals.locale;
const t = useT(locale);

const guard = await requireSession(getBff(), toBffContext(Astro));
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

const { session } = guard;

const { slug } = Astro.params;
const projectSourced = slug ? await loadProject(session, slug) : undefined;
if (!projectSourced) return new Response(t('common.notFound'), { status: 404 });
const project = projectSourced.data;

const [tablesSourced, apiSourced, pg] = await Promise.all([
  loadDbTables(session, project.slug),
  loadDbApiInfo(session, project.slug),
  loadPostgresService(session, project.slug),
]);
const { data: dbTables, live: tablesLive } = tablesSourced;
const { data: dbApiInfo, live: apiLive } = apiSourced;
const live = tablesLive && apiLive;

// Precalcular filas por tabla para la carga inicial (SSR); el resto se pide bajo
// demanda desde el cliente contra /api/db/rows.
const rowsByTable: Record<string, DbRows> = {};
const preload = dbTables.slice(0, 4);
const loaded = await Promise.all(
  preload.map((t) => loadDbRows(session, project.slug, t.schema, t.name)),
);
preload.forEach((t, i) => {
  rowsByTable[`${t.schema}.${t.name}`] = loaded[i]!.data;
});
---

<DashboardLayout
  title={t('page.titleWithProject', { section: t('nav.database'), project: project.name })}
  project={project.slug}
  section="database"
  hasDb={project.services.includes('postgres')}
>
  <DbStudio
    client:load
    project={project.slug}
    tables={dbTables}
    rowsByTable={rowsByTable}
    api={dbApiInfo}
    live={live}
    serviceId={pg?.id ?? ''}
    serviceName={pg?.name ?? project.name}
    backupSchedule={pg?.backupSchedule ?? ''}
    provisioned={project.services.includes('postgres')}
    locale={locale}
    error={firstSourceError(projectSourced, tablesSourced, apiSourced)}
  />
</DashboardLayout>
