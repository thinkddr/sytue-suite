---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import TasksPanel from '../../../components/TasksPanel';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../../../server/bff.js';
import { loadProject, loadServices, loadBuiltImages } from '../../../lib/cloud.js';

import { useT } from '../../../i18n/index.js';

export const prerender = false;

// El idioma lo negocia el middleware una vez por peticion y baja a la isla por
// props: detectarlo en el cliente desajustaria la hidratacion.
const locale = Astro.locals.locale;
const t = useT(locale);

const guard = await requireSession(getBff(), toBffContext(Astro));
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

const { session } = guard;

const { slug } = Astro.params;
const projectSourced = slug ? await loadProject(session, slug) : undefined;
if (!projectSourced) return new Response(t('common.notFound'), { status: 404 });
const project = projectSourced.data;

// Cron y job son servicios gestionados del proyecto; las imagenes con las que
// pueden correr salen de las builds que ya terminaron bien.
const [services, images] = await Promise.all([
  loadServices(session, project.slug),
  loadBuiltImages(session, project.slug),
]);
---

<DashboardLayout
  title={t('page.titleWithProject', { section: t('nav.tasks'), project: project.name })}
  project={project.slug}
  section="tasks"
  hasDb={project.services.includes('postgres')}
>
  <TasksPanel
    client:load
    project={project.slug}
    crons={services.data.filter((s) => s.kind === 'cron')}
    jobs={services.data.filter((s) => s.kind === 'job')}
    workers={services.data.filter((s) => s.kind === 'worker')}
    images={images.data}
    live={projectSourced.live && services.live}
    locale={locale}
    error={projectSourced.error}
  />
</DashboardLayout>
