---
/**
 * Tokens de API — la credencial con la que se usan el CLI, Terraform y CI. El
 * backend ya existía; sin esta página no había forma de emitir una.
 */
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TokensPanel from '../components/TokensPanel';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../server/bff.js';
import { loadApiTokens } from '../lib/cloud.js';

import { useT } from '../i18n/index.js';

export const prerender = false;

// El idioma lo negocia el middleware una vez por petición y baja a la isla por
// props: detectarlo en el cliente desajustaría la hidratación.
const locale = Astro.locals.locale;
const t = useT(locale);

const guard = await requireSession(getBff(), toBffContext(Astro));
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

const { live, data: tokens, error } = await loadApiTokens(guard.session);
---

<DashboardLayout title={t('nav.tokens')} section="tokens" error={error}>
  <TokensPanel client:load tokens={tokens} live={live} error={error} locale={locale} />
</DashboardLayout>
