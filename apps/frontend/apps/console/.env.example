# Sytue Admin (admin.sytue.eu). BFF OIDC contra Sytue ID (client
# confidencial sytue-console). Copia a .env en dev. NUNCA secretos reales en git:
# en prod vienen de Scaleway Secret Manager / Sealed Secrets. docs/CONVENTIONS.md §8, §10.

# --- OIDC (Sytue ID, client confidencial sytue-console) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

# --- Sesion ---
SYTUE_SESSION_SECRET=
SYTUE_COOKIES_SECURE=

# --- Backends (UE) ---
# Sytue Hub (shell global + puente SCIM/admin de Sytue ID) — dev 8092.
SYTUE_HUB_URL=
# API de administracion de Sytue ID via control-plane (identidad/SCIM) — dev 8081.
SYTUE_ADMIN_API_URL=
# Sytue Mail (API admin de compliance: legal hold + eDiscovery) — dev 8086.
SYTUE_MAIL_API_URL=
# Sytue Drive (API admin de compliance: legal hold + eDiscovery) — dev 8082.
SYTUE_DRIVE_API_URL=
