---
/*
 * Dispositivos de confianza (paridad Entra device-based Conditional Access). Dos vistas:
 * MIS dispositivos (marcar de confianza el actual, revocar) y los de la ORGANIZACIÓN
 * (admin: revocar). Reenvía la cookie de dispositivo (httpOnly, firmada) del navegador a
 * Sytue ID para que marque cuál es el dispositivo actual.
 */
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import { useT } from '../i18n/index.js';
import DevicesPanel from '../components/DevicesPanel';
import { requireSession, deviceCookieHeader } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../server/bff.js';
import { loadMyDevices, loadOrgDevices } from '../lib/admin.js';

export const prerender = false;

const guard = await requireSession(getBff(), toBffContext(Astro), {
  roles: ['admin', 'owner'],
  perms: ['users.read', 'users.manage'],
});
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

const deviceCookie = deviceCookieHeader((n) => Astro.cookies.get(n)?.value);
const [mine, orgList] = await Promise.all([
  loadMyDevices(guard.session, deviceCookie),
  loadOrgDevices(guard.session),
]);
const live = mine.live && orgList.live;

// El idioma lo negoció el middleware; la isla lo recibe por props (nunca lo detecta).
const locale = Astro.locals.locale;
const t = useT(locale);
---

<ConsoleLayout title={t('page.devices')} section="devices">
  <DevicesPanel
    client:load
    locale={locale}
    myDevices={mine.data}
    orgDevices={orgList.data}
    live={live}
  />
</ConsoleLayout>
