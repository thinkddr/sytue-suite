 *
 * Derechos RGPD del lado del responsable (ADR 0054, enmienda del 2026-11-25): el
 * registro de solicitudes de la organización y la supresión física de una cuenta.
 * Owner/admin, como en Sytue ID: responder en nombre de la organización no se
 * delega.
 */
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import PrivacyPanel from '../components/PrivacyPanel';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../server/bff.js';
import { loadUsers } from '../lib/admin.js';
import type { ListadoRGPD } from '../lib/privacidad.js';
import { listarSolicitudes } from '../lib/privacidad-api.js';
import { useTPrivacidad } from '../i18n/privacidad/index.js';

export const prerender = false;

const guard = await requireSession(getBff(), toBffContext(Astro), { roles: ['admin', 'owner'] });
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

// Las abiertas de entrada (lo que hay que contestar) y el directorio para elegir a
// la persona. Si el registro no contesta, la isla lo dice en vez de pintar un
// registro vacío que parecería verdad.
const [usuarios, inicial] = await Promise.all([
  loadUsers(guard.session, undefined, { limit: 200 }),
  listarSolicitudes(guard.session, { status: 'open' }).catch((): ListadoRGPD | null => null),
]);
const personas = usuarios.data.items.map((u) => ({
  id: u.id,
  email: u.email,
  fullName: u.fullName,
}));

const locale = Astro.locals.locale;
const t = useTPrivacidad(locale);
---

<ConsoleLayout title={t('privacidad.titulo')} section="privacy">
  <PrivacyPanel client:load locale={locale} personas={personas} inicial={inicial} />
</ConsoleLayout>
