---
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import { useT } from '../i18n/index.js';
import PrivilegedAccessPanel from '../components/PrivilegedAccessPanel';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../server/bff.js';
import {
  loadCustomRoles,
  loadMyPim,
  loadPimActivations,
  loadPimEligibilities,
  loadUsers,
} from '../lib/admin.js';

export const prerender = false;

const guard = await requireSession(getBff(), toBffContext(Astro), { roles: ['admin', 'owner'] });
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

// Self (mis elegibilidades/activaciones) + admin (elegibilidades, activaciones) + los
// selectores de usuario y rol para definir elegibilidades.
const [myPim, eligibilities, activations, usersPage, roles] = await Promise.all([
  loadMyPim(guard.session),
  loadPimEligibilities(guard.session),
  loadPimActivations(guard.session),
  loadUsers(guard.session, undefined, { limit: 200 }),
  loadCustomRoles(guard.session),
]);
const users = usersPage.data.items.map((u) => ({ id: u.id, email: u.email, name: u.fullName }));
const roleRefs = roles.data.map((r) => ({ id: r.id, name: r.name }));
const live = myPim.live && eligibilities.live && activations.live;

// El idioma lo negoció el middleware; la isla lo recibe por props (nunca lo detecta).
const locale = Astro.locals.locale;
const t = useT(locale);
---

<ConsoleLayout title={t('page.pim')} section="pim">
  <PrivilegedAccessPanel
    client:load
    locale={locale}
    myEligibilities={myPim.data.eligibilities}
    myActivations={myPim.data.activations}
    eligibilities={eligibilities.data}
    activations={activations.data}
    users={users}
    roles={roleRefs}
    live={live}
  />
</ConsoleLayout>
