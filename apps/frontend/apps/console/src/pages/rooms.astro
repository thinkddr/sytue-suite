---
/*
 * Administración de Sytue Rooms — canales de la organización.
 *
 * Los datos se piden en el SERVIDOR y bajan como props: es una lista que se lee
 * nada más entrar, y pedirla desde el navegador solo añadiría un salto en blanco.
 *
 * Quién entra lo decide Rooms en cada petición (`RequireRole("owner","admin")`);
 * aquí se exige el mismo rol para no servir una pantalla que va a responder 403
 * en todas sus llamadas.
 */
import ConsoleLayout from '../layouts/ConsoleLayout.astro';
import { useT } from '../i18n/index.js';
import RoomsPanel from '../components/RoomsPanel';
import { requireSession } from '@sytue/auth/server';
import { canonicaConOrg } from '@sytue/config';
import { getBff, toBffContext } from '../server/bff.js';
import { loadRoomsChannels, loadRoomsStats } from '../lib/rooms.js';

export const prerender = false;

const guard = await requireSession(getBff(), toBffContext(Astro), {
  roles: ['admin', 'owner'],
});
if (guard instanceof Response) return guard;
// Ruta en `sinOrg` (su nombre colisiona con el namespace de organizaciones):
// con sesión, un salto local a la canónica con la org activa (ADR 0056).
const canonica = canonicaConOrg(Astro.url, getBff().basePath, guard.session.user.tenant);
if (canonica) return Astro.redirect(canonica);

// Se piden los archivados desde el principio: el interruptor de la pantalla solo
// los oculta. Traerlos aparte al activarlo obligaría a un segundo viaje justo
// cuando alguien busca el canal que archivó por error, que es el caso urgente.
const [canales, stats] = await Promise.all([
  loadRoomsChannels(guard.session, true),
  loadRoomsStats(guard.session),
]);

// El código manda: 403 es «no eres admin de esta organización» y 502, «Rooms no
// contesta». Son pantallas distintas y sin el código serían la misma lista vacía.
const problema = canales.ok ? undefined : canales.status;

const locale = Astro.locals.locale;
const t = useT(locale);
---

<ConsoleLayout title={t('nav.rooms')} section="rooms">
  <RoomsPanel
    client:load
    locale={locale}
    channels={canales.data}
    stats={stats.ok ? stats.data : null}
    problema={problema}
  />
</ConsoleLayout>
