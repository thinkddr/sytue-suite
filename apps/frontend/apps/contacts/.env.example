# Sytue Contacts — variables de entorno (ejemplo). Copiar a .env en dev.
# NUNCA secretos reales en git: en prod vienen de Scaleway Secret Manager /
# Sealed Secrets. Solo placeholders aqui. docs/CONVENTIONS.md §8, §10.

# --- OIDC (Sytue ID, client confidencial sytue-contacts) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

SYTUE_SESSION_SECRET=

# --- Backends (UE): servicio Go propio Sytue Contacts (CardDAV + REST) ---
# Servicio Go Sytue Contacts (dev 8088, docs/CONVENTIONS.md §6).
SYTUE_CONTACTS_BASE_URL=
SYTUE_HUB_BASE_URL=
