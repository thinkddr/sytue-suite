# Sytue Drive (drive.sytue.eu). BFF OIDC contra Sytue ID (client sytue-drive).
# Copia a .env (no se versiona). NUNCA pongas secretos reales en git.

# --- OIDC (Sytue ID) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

# --- Sesion ---
SYTUE_SESSION_SECRET=
SYTUE_SECURE_COOKIES=

# --- Servicios Sytue (Go) ---
PUBLIC_SYTUE_HUB_BASE_URL=
# Servicio Go de Sytue Drive (REST + WebDAV; dev 8082)
PUBLIC_SYTUE_DRIVE_BASE_URL=
