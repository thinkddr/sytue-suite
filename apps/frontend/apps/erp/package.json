{
  "name": "@sytue/erp",
  "version": "1.0.0",
  "private": true,
  "description": "SyERP \u2014 el ERP de la suite (Astro 7 + Preact 10) sobre el servicio Go propio SyERP. Una sola interfaz generada del cat\u00e1logo de m\u00f3dulos que publica el servicio: lista, ficha y paleta de comandos sirven a los treinta y seis modelos sin una l\u00ednea de c\u00f3digo por m\u00f3dulo. Producto Sytue-native, propietario. docs/CONVENTIONS.md \u00a71.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --port 4334 --host",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --port 4334 --host",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/offline": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "astro": "catalog:",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
