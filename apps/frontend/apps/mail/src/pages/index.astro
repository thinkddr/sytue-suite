---
/**
 * Sytue Mail — bandeja de entrada. SSR: el layout exige sesion y serializa el
 * usuario; la isla MailApp (client:load) monta la Sytue Shell + la UI tipo Gmail.
 * El access token jamas se renderiza en el HTML: la isla lo pide al BFF cuando
 * lo necesita (solo para el Hub). docs/CONVENTIONS.md §1.
 */
import { returnToCanonico } from '@sytue/config';
import AppLayout from '../layouts/AppLayout.astro';
import { serverEnv } from '@sytue/auth/server';
import { MailApp } from '../components/MailApp.js';
import { bff, toBffContext } from '../lib/bff.js';
import { useT } from '../i18n/index.js';

export const prerender = false;

// Guard: en .astro el redirect debe RETORNARSE (Astro no sigue un throw de
// Response fuera de middleware). Sin sesion -> login SSO.
const session = await bff.getSession(toBffContext(Astro));
if (!session) {
  // ADR 0056: la entrada org-ful llega reescrita con la marca ?__org=; el returnTo
  // sale canónico, no en la forma interna, o tras el login la barra se queda con ella.
  const returnTo = returnToCanonico(Astro.url, bff.basePath);
  const redireccionLogin = Astro.redirect(
    `${bff.basePath}/auth/login?returnTo=${encodeURIComponent(returnTo)}`,
  );
  redireccionLogin.headers.set('cache-control', 'no-store');
  return redireccionLogin;
}
const hubBaseUrl = serverEnv(import.meta.env).SYTUE_HUB_BASE_URL ?? 'https://hub.sytue.eu';
// Sytue ID: ahí se crean las CONTRASEÑAS DE APLICACIÓN, que es lo único que se
// puede escribir en Thunderbird, Outlook, Apple Mail o el móvil. Sin este enlace
// la función existe y no la encuentra nadie: el webmail es de donde sale quien
// quiere configurar su cliente.
const idBaseUrl = (serverEnv(import.meta.env).SYTUE_OIDC_ISSUER ?? 'https://id.sytue.eu').replace(
  /\/+$/,
  '',
);
// El idioma lo negoció el middleware; de aquí baja por PROPS a la isla. Detectarlo
// dentro de la isla desajustaría la hidratación (el servidor ya pintó en él).
const locale = Astro.locals.locale;
const t = useT(locale);
---

<AppLayout title={t('page.title')}>
  <MailApp
    slot="app"
    client:load
    user={session.user}
    hubBaseUrl={hubBaseUrl}
    idBaseUrl={idBaseUrl}
    locale={locale}
  />
</AppLayout>
