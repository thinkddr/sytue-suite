# Sytue Notepads — variables de entorno (ejemplo). Copiar a .env en dev.
# NUNCA secretos reales en git: en prod vienen de Scaleway Secret Manager /
# Sealed Secrets. Solo placeholders aqui. docs/CONVENTIONS.md §8, §10.

# --- OIDC (Sytue ID, client confidencial sytue-notes) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

SYTUE_SESSION_SECRET=

# --- Backends (UE) ---
# Servicio Go Sytue Notepads (dev 8089, docs/CONVENTIONS.md §6).
SYTUE_NOTES_BASE_URL=
PUBLIC_SYTUE_NOTES_BASE_URL=
SYTUE_HUB_BASE_URL=

# Servicios que alimentan los selectores de incrustacion. El token de la sesion
# no sale del servidor: el navegador habla solo con el BFF de esta app.
SYTUE_DRIVE_API_URL=
PUBLIC_SYTUE_DRIVE_BASE_URL=
SYTUE_DOCS_API_URL=
PUBLIC_SYTUE_DOCS_BASE_URL=
SYTUE_CALENDAR_API_URL=
PUBLIC_SYTUE_CALENDAR_BASE_URL=
SYTUE_ROOMS_API_URL=
PUBLIC_SYTUE_ROOMS_BASE_URL=
