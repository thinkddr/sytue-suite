{
  "name": "@sytue/pages",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue Web — editor visual de sitios web y tiendas (Astro 7 + Preact 10). Mis sitios, editor visual, publicación, versiones, dominios, tienda y analítica. docs/CONVENTIONS.md §1.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --port 4336 --host",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --port 4336 --host",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "bun --bun astro check"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/pages-render": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "astro": "catalog:",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
