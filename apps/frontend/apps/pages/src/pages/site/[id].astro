---
import AppLayout from '../../layouts/AppLayout.astro';
import { SitioDetalleApp } from '../../islands/SitioDetalleApp.js';
import { protegerPagina, hubBaseUrl } from '../../lib/pagina.js';
import { t } from '../../i18n/index.js';

export const prerender = false;

const guard = await protegerPagina(Astro);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
const siteId = id || '';
const locale = Astro.locals.locale;
---

<AppLayout title={`${t(locale, 'ficha.page_title')} · ${t(locale, 'nav.title')}`}>
  <SitioDetalleApp
    slot="app"
    client:load
    siteId={siteId}
    locale={locale}
    user={guard.session.user}
    hubBaseUrl={hubBaseUrl()}
  />
</AppLayout>
