---
/**
 * /p/{token} — un álbum COMPARTIDO, en solo lectura y SIN sesión.
 *
 * La credencial es el token del enlace, así que aquí no se monta la Sytue Shell
 * ni se pide identidad: quien abre esto puede no tener cuenta. El servicio Go
 * sirve el álbum por `/public/albums/{token}` con su propio tope por IP, y las
 * imágenes van por `/p/{token}/img/…`, que comprueba que cada foto esté en ese
 * álbum.
 *
 * `noindex` en la página además de en la respuesta del servicio: «cualquiera con
 * el enlace» no es «cualquiera», y un álbum de familia en el índice de un
 * buscador sería exactamente lo que nadie pidió al pulsar «compartir».
 */
import '../../styles/app.css';
import { SUFIJO_ICONOS, themeInitScript, withBase } from '@sytue/ui';
import { htmlLangAttrs } from '@sytue/i18n';
import { serverEnv } from '@sytue/auth/server';
import { useT } from '../../i18n/index.js';
import { proporcion } from '../../lib/filas.js';

export const prerender = false;

const env = serverEnv(import.meta.env);
const destino = (env.SYTUE_PHOTOS_API_URL ?? 'http://syphotos:8097').replace(/\/$/, '');
const token = Astro.params.token ?? '';

interface FotoPublica {
  id: string;
  name: string;
  width: number;
  height: number;
  takenAt: string;
}
let datos: { album: { title: string; count: number }; items: FotoPublica[] } | null = null;
try {
  const res = await fetch(`${destino}/public/albums/${encodeURIComponent(token)}`, {
    headers: { accept: 'application/json' },
  });
  if (res.ok) datos = await res.json();
} catch {
  // Sin servicio detrás no hay nada que enseñar: se contesta 404 igual que si
  // el enlace no existiera. Distinguirlo diría qué tokens son válidos.
}
if (!datos) return new Response(null, { status: 404 });

const { lang, dir } = htmlLangAttrs(Astro.locals.locale);
const t = useT(Astro.locals.locale);
const prefijo = env.SYTUE_BASE_PATH ?? import.meta.env.BASE_URL;
const img = (id: string, variante: string) =>
  withBase(prefijo, `/p/${encodeURIComponent(token)}/img/${encodeURIComponent(id)}/${variante}`);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{datos.album.title}</title>
    {/* Con el sufijo, como el resto: esta página la abre gente de fuera en su
        navegador, y Safari no vuelve a pedir un icono que ya falló una vez. */}
    <link
      rel="icon"
      href={withBase(prefijo, '/favicon.svg') + SUFIJO_ICONOS}
      type="image/svg+xml"
    />
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body class="bg-bg text-text min-h-dvh">
    <div class="mx-auto w-full max-w-7xl px-4 py-6">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold">{datos.album.title}</h1>
        <p class="text-text-muted text-sm">{t('public.count', { count: datos.album.count })}</p>
      </header>
      {/* Las mismas filas justificadas que la galería (`.filas`, en app.css): la
          rejilla de antes daba a cada foto su proporción dentro de una celda, y
          dejaba bandas vacías bajo las más bajas de cada fila. */}
      <ul class="filas">
        {datos.items.map((f) => (
          <li style={`--r: ${proporcion(f)}`} class="bg-bg-subtle rounded-sm">
            {/* Enlace a la variante grande: sin sesión no hay visor con
                  atajos, pero abrir la foto entera sí tiene que poder hacerse. */}
            <a
              href={img(f.id, 'grande')}
              class="sytue-focus-ring-inset block h-full w-full overflow-hidden rounded-sm"
            >
              <img
                src={img(f.id, 'miniatura')}
                alt={f.name}
                width={f.width}
                height={f.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </a>
          </li>
        ))}
      </ul>
      <p class="text-text-subtle mt-8 text-center text-xs">{t('public.by')}</p>
    </div>
  </body>
</html>
