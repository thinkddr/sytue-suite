---
/**
 * /shared[?album=<id>] — «Compartido conmigo»: los álbumes que otras personas han
 * compartido conmigo y, con `album`, uno de ellos. El aviso `photos.shared` del Hub
 * abre aquí (`hubnotify.EnlaceAlbumCompartido`).
 */
import AppLayout from '../layouts/AppLayout.astro';
import { Compartidos } from '../components/Compartidos.js';
import { serverEnv } from '@sytue/auth/server';
import { bff, toBffContext } from '../lib/bff.js';
import { canonicaConOrg, returnToCanonico } from '@sytue/config';

export const prerender = false;

const session = await bff.getSession(toBffContext(Astro));
if (!session) {
  // ADR 0056: el returnTo sale canónico, no en la forma interna con ?__org=.
  const returnTo = returnToCanonico(Astro.url, bff.basePath);
  const redireccionLogin = Astro.redirect(
    `${bff.basePath}/auth/login?returnTo=${encodeURIComponent(returnTo)}`,
  );
  redireccionLogin.headers.set('cache-control', 'no-store');
  return redireccionLogin;
}
// Ruta en `sinOrg`: con sesión, un salto local a la canónica con la org activa.
const canonica = canonicaConOrg(Astro.url, bff.basePath, session.user.tenant);
if (canonica) return Astro.redirect(canonica);
const album = Astro.url.searchParams.get('album');
const hubBaseUrl = serverEnv(import.meta.env).SYTUE_HUB_BASE_URL ?? 'https://hub.sytue.eu';
---

<AppLayout title="Sytue Fotos">
  <Compartidos
    slot="app"
    client:load
    locale={Astro.locals.locale}
    user={session.user}
    hubBaseUrl={hubBaseUrl}
    album={album}
  />
</AppLayout>
