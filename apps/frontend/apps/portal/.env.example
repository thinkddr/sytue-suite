# Sytue One — portal (one.sytue.eu). BFF OIDC contra Sytue ID (client sytue-one).
# Copia a .env (no se versiona). NUNCA pongas secretos reales en git: usa
# Scaleway Secret Manager / Sealed Secrets en prod.

# --- OIDC (Sytue ID) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

# --- Sesion (cookie httpOnly de la suite) ---
SYTUE_SESSION_SECRET=
# secure=false solo en dev local sobre http
SYTUE_SECURE_COOKIES=

# --- Integracion ---
PUBLIC_SYTUE_HUB_BASE_URL=
