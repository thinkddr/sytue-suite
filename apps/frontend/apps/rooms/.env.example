# Sytue Chat — variables de entorno (ejemplo). Copiar a .env en dev.
# NUNCA poner secretos reales en git: en prod vienen de Scaleway Secret Manager
# / Sealed Secrets. Solo placeholders aqui. docs/CONVENTIONS.md §8, §10.

# --- OIDC (Sytue ID, client confidencial sytue-chat) ---
SYTUE_OIDC_ISSUER=
SYTUE_OIDC_CLIENT_ID=
SYTUE_OIDC_CLIENT_SECRET=
SYTUE_OIDC_REDIRECT_URI=
SYTUE_OIDC_POST_LOGOUT_URI=
SYTUE_OIDC_SCOPES=

# Secreto de cifrado de la cookie de sesion (>= 32 caracteres).
SYTUE_SESSION_SECRET=

# --- Backend (UE): servicio Go propio Sytue Chat (REST + WebSocket) ---
# REST/HTTP del servicio Go (dev 8085, docs/CONVENTIONS.md §6).
SYTUE_CHAT_API_URL=
# Endpoint WebSocket del servicio Go (mismo origen, ruta /ws).
SYTUE_CHAT_WS_URL=
SYTUE_HUB_BASE_URL=
