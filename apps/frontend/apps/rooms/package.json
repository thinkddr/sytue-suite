{
  "name": "@sytue/rooms",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue Rooms — mensajeria y videollamada (Astro 7 + Preact 10) sobre el servicio Go propio Sytue Rooms (WebSocket + REST + salas). Canales, vista de canal, redaccion y la llamada embebida en el canal (LiveKit web SDK). Monta la Sytue Shell y usa @sytue/ui. Producto Sytue-native, propietario. docs/CONVENTIONS.md §1.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4330 --host",
    "build": "astro build",
    "preview": "astro preview --port 4330 --host",
    "start": "bun ./dist/server/entry.mjs",
    "test": "bun test",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@astrojs/preact": "catalog:",
    "@sytue/ai": "workspace:*",
    "@sytue/api-clients": "workspace:*",
    "@sytue/auth": "workspace:*",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@sytue/offline": "workspace:*",
    "@sytue/shell": "workspace:*",
    "@sytue/ui": "workspace:*",
    "astro": "catalog:",
    "livekit-client": "2.22.3",
    "preact": "10.29.8",
    "matrix-js-sdk": "44.0.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
