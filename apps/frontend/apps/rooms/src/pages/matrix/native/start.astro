---
import { appForKey, type SuiteApp } from '@sytue/ui';
import { fontFamily, themeColors, brand } from '@sytue/config';
import { bff, toBffContext } from '../../../lib/bff.js';
import { chatSdk } from '../../../lib/chat.js';
import { roomsT } from '../../../i18n/index.js';
import { matrixNativeConsent } from '../../../lib/matrix-native-consent.js';
import { opaqueMatrixNative } from '../../../client/matrix/native.js';
export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
const state = Astro.url.searchParams.get('state');
const t = roomsT(Astro.locals.locale);
if (!opaqueMatrixNative(state) || Astro.url.searchParams.getAll('state').length !== 1)
  return new Response(null, { status: 400 });
const session = await bff.getSession(toBffContext(Astro));
if (!session) {
  const returnTo = `${bff.basePath}/matrix/native/start?state=${encodeURIComponent(state)}`;
  const destination = new URL(`${bff.basePath}/auth/login`, Astro.url.origin);
  destination.searchParams.set('returnTo', returnTo);
  const response = Astro.redirect(destination.href);
  response.headers.set('cache-control', 'no-store');
  response.headers.set('referrer-policy', 'no-referrer');
  return response;
}
let failed = false;
let consent: { app: SuiteApp; tenant: string } | undefined;
try {
  const sdk = chatSdk(session.tokens.accessToken);
  let preview = await sdk.previewMatrixNative(state);
  // New storage handoffs do not initialize a Rooms conversation space. Keep the
  // old metadata lookup only for an older backend during a rolling deployment.
  const bootstrap =
    preview.homeserver_url !== undefined && preview.sso_provider_id !== undefined
      ? {
          actor: preview.actor,
          tenant: preview.tenant,
          homeserver_url: preview.homeserver_url,
          sso_provider_id: preview.sso_provider_id,
        }
      : await sdk.matrixBootstrap();
  const current = {
    actor: session.user.id,
    state,
    origin: Astro.url.origin,
    basePath: bff.basePath,
  };
  let handoff = matrixNativeConsent(preview, bootstrap, current);
  if (handoff.app && handoff.requiresApproval) {
    if (Astro.request.method === 'POST') {
      const form = await Astro.request.formData();
      if (form.get('state') !== state || form.get('decision') !== 'approve')
        return new Response(null, { status: 400 });
      const original = handoff;
      await sdk.approveMatrixResourceNative(state);
      preview = await sdk.previewMatrixNative(state);
      handoff = matrixNativeConsent(preview, bootstrap, current);
      if (
        handoff.requiresApproval ||
        handoff.app?.key !== original.app?.key ||
        handoff.tenant !== original.tenant
      )
        throw new Error('matrix_consent');
    } else {
      consent = { app: handoff.app, tenant: handoff.tenant };
    }
  } else if (!handoff.app && Astro.request.method !== 'GET') {
    return new Response(null, { status: 405 });
  }
  if (!consent) {
    const response = Astro.redirect(handoff.target.href);
    response.headers.set('cache-control', 'no-store');
    response.headers.set('referrer-policy', 'no-referrer');
    return response;
  }
} catch {
  failed = true;
}
---

<!doctype html>
<html lang={Astro.locals.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{consent ? t('nativeResource.title', { app: consent.app.name }) : 'Sytue'}</title>
  </head>
  <body>
    <main aria-labelledby={consent ? 'consent-title' : undefined}>
      {consent ? (
        <>
          <img src={consent.app.iconUrl} alt="" width="64" height="64" />
          <h1 id="consent-title">{t('nativeResource.title', { app: consent.app.name })}</h1>
          <p id="consent-description">
            {t('nativeResource.description', { tenant: consent.tenant })}
          </p>
          <form
            method="POST"
            action={Astro.url.pathname + Astro.url.search}
            aria-describedby="consent-description"
          >
            <input type="hidden" name="state" value={state} />
            <button type="submit" name="decision" value="approve">
              {t('nativeResource.approve')}
            </button>
            <a href={appForKey('one')?.href ?? '/'}>{t('meet.prejoin.cancel')}</a>
          </form>
        </>
      ) : (
        <p role="alert">{failed ? t('whatsappConnection.sameAccount') : t('state.loading')}</p>
      )}
    </main>
  </body>
</html>
<style
  define:vars={{
    font: fontFamily.sans,
    bg: themeColors.light.bg,
    fg: themeColors.light.text,
    muted: themeColors.light['text-muted'],
    accent: brand.primary[700],
    ring: brand.primary[500],
  }}
>
  :global(html) {
    color-scheme: light;
  }
  :global(body) {
    margin: 0;
    min-block-size: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    box-sizing: border-box;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
  }
  main {
    inline-size: min(100%, 27rem);
    text-align: center;
  }
  img {
    margin-block-end: 1rem;
  }
  h1 {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-block: 1rem 2rem;
  }
  form {
    display: grid;
    gap: 0.75rem;
  }
  button,
  a {
    min-block-size: 3rem;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  button {
    background: var(--accent);
    color: white;
    border: none;
    padding-inline: 1rem;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 3px;
  }
</style>
