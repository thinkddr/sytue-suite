---
/**
 * MarketingLayout — layout del sitio público de Sytue One. Estático (SSG), con
 * la topbar canónica de @sytue/ui (marca + navegación + selector de idioma + CTA
 * de acceso) y pie de página. No requiere sesión; el acceso lleva a Sytue One
 * (one.sytue.eu). Diseño moderno Sytue, claro/oscuro. docs/CONVENTIONS.md §4, §5.
 *
 * SEO (contrato §0.8): HTML semántico, metadatos + OpenGraph/Twitter Cards,
 * datos estructurados JSON-LD (schema.org Organization/WebSite/
 * SoftwareApplication), canonical + hreflang. `noindex` para superficies que no
 * deben indexarse; ese es el patrón que replican las apps autenticadas.
 * docs/operations.md
 *
 * La página NO pasa su URL: pasa su ruta BASE (la del inglés, sin prefijo) y su
 * idioma. La canónica y los alternos se derivan de ahí, así que no hay forma de
 * que una traducción se declare canónica de otra por un copy-paste.
 */
import '../styles/app.css';
import { intlTag, type Locale } from '@sytue/i18n';
import { SUFIJO_ICONOS, themeInitScript } from '@sytue/ui';
import { brand } from '@sytue/config';
import SiteHeader from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
import { localePath, useT } from '../i18n';
import { DEFAULT_OG_IMAGE, absoluteUrl, hreflangAlternates } from '../lib/seo';

interface Props {
  /** Idioma de esta página. */
  locale: Locale;
  /** Ruta BASE (sin prefijo de idioma): '/', '/downloads', '/product/mail'. */
  path: string;
  title: string;
  description: string;
  /** Imagen social (OG/Twitter). Absoluta o relativa a /public. */
  ogImage?: string;
  /** Tipo OpenGraph (website | article | ...). */
  ogType?: string;
  /**
   * `noindex` desindexa la página: superficies autenticadas/utilitarias no se
   * indexan (contrato §0.8). Las apps autenticadas fijan esto SIEMPRE a true.
   */
  noindex?: boolean;
  /**
   * Idiomas en los que esta página EXISTE. Vacío = sin alternos (404). Declarar
   * un idioma sin traducción manda al rastreador a un 404.
   */
  alternates?: readonly Locale[];
  /** JSON-LD adicionales a inyectar en la página (schema.org). */
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  path,
  title,
  description,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  noindex = false,
  alternates = [],
  jsonLd = [],
} = Astro.props;

const t = useT(locale);

// La cabecera es una isla y recibe sus textos YA traducidos. Si llevara `t`
// dentro, el bundle del navegador se llevaría los cinco catálogos completos
// (~118 kB, páginas legales incluidas) solo para pintar una topbar.
const headerLabels = {
  products: t('nav.products'),
  sovereignty: t('nav.sovereignty'),
  standards: t('nav.standards'),
  pricing: t('nav.pricing'),
  downloads: t('nav.downloads'),
  nav: t('nav.aria'),
  navMobile: t('nav.ariaMobile'),
  home: t('nav.home'),
  openMenu: t('nav.openMenu'),
  closeMenu: t('nav.closeMenu'),
  toLight: t('theme.toLight'),
  toDark: t('theme.toDark'),
  language: t('lang.label'),
  signIn: t('cta.signIn'),
  start: t('cta.start'),
};

const canonicalUrl = absoluteUrl(localePath(locale, path));
const alternateLinks = hreflangAlternates(path, alternates);
const ogImageUrl = absoluteUrl(ogImage);
const htmlLang = intlTag(locale);
const ogLocale = htmlLang.replace('-', '_');
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang={htmlLang} class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <!-- `interactive-widget=resizes-content`: sin esto el teclado virtual NO encoge el
         viewport de maquetación, así que el `100dvh` del armazón sigue midiendo la
         pantalla entera y lo que se está escribiendo queda DEBAJO del teclado — el
         navegador desplaza el viewport visual para enseñar el campo y se lleva por
         delante los botones que van con él. Se vio en el redactor de Sytue Mail. Lo
         declaraba solo Sytue Rooms, que fue donde se descubrió.

         SIN `viewport-fit=cover`, que Rooms sí trae: extiende el lienzo bajo la muesca
         y el indicador de inicio, y para eso hay que rellenar con `env(safe-area-inset-*)`.
         Nadie en la suite lo hace todavía —Rooms tampoco—, así que añadirlo aquí
         metería contenido debajo del hardware en vez de arreglar nada. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />

    <!-- Título + descripción -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Indexación: público indexable; autenticadas/utilidades noindex -->
    <meta name="robots" content={robots} />

    <!-- URL canónica (la de ESTE idioma) + alternos hreflang recíprocos -->
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- OpenGraph -->
    <meta property="og:site_name" content="Sytue One" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternates
      .filter((l) => l !== locale)
      .map((l) => (
        <meta property="og:locale:alternate" content={intlTag(l).replace('-', '_')} />
      ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Rendimiento: pistas de recursos y favicon -->
    {/* CON `SUFIJO_ICONOS`, COMO LAS DEMÁS SUPERFICIES. Safari guarda el icono
        POR PÁGINA y no vuelve a pedirlo aunque el `<link>` no haya cambiado:
        quien abrió esta página alguna vez sin icono se queda sin él para
        siempre, y cambiar la URL es lo único que le hace volver a mirar. Eso se
        arregló en las once apps (#108) y el sitio público se quedó fuera: era
        la única superficie sin el sufijo. Los ficheros estaban y estaban bien
        —el .ico trae 16, 32, 48 y 64, y los cuatro llevan el «sy:»—, así que lo
        único que faltaba era esto. */}
    <link rel="icon" href={`/favicon.ico${SUFIJO_ICONOS}`} sizes="32x32" />
    <link rel="icon" href={`/favicon-64.png${SUFIJO_ICONOS}`} type="image/png" sizes="64x64" />
    <link rel="icon" href={`/favicon.svg${SUFIJO_ICONOS}`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png${SUFIJO_ICONOS}`} />
    <meta name="color-scheme" content="light dark" />
    {/* theme-color derivado del token de marca (branding/tokens/colors.json). */}
    <meta name="theme-color" content={brand.primary[500]} />

    <!-- Datos estructurados JSON-LD (schema.org) -->
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} is:inline></script>
    ))}

    <!-- Evita el flash de tema: aplica preferencia antes del primer render -->
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body class="bg-bg text-text min-h-full antialiased">
    <a
      href="#content"
      class="focus:bg-primary sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-control focus:px-4 focus:py-2 focus:text-[var(--sytue-on-primary)]"
    >
      {t('skip.content')}
    </a>
    <SiteHeader client:load locale={locale} path={path} labels={headerLabels} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
