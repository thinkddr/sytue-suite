---
/*
 * SPDX-License-Identifier: Apache-2.0
 * SPDX-FileCopyrightText: (c) 2026 Daniel Delgado Ramos
 *
 * Aviso legal (LSSI, art. 10): identificación del titular del sitio y del
 * servicio. Los datos registrales son los del Registro Mercantil de Madrid
 * (BORME, inscripción del 13/05/2026: sección 8, hoja M-887153, inscripción 1.ª)
 * y van como CONSTANTES, iguales en todos los idiomas: una denominación social,
 * un NIF y un domicilio no se traducen. Lo demás —objeto, propiedad, responsabilidad,
 * ley aplicable— sale del catálogo y lleva el mismo aviso de revisión legal que
 * privacidad y términos.
 */
import { LOCALES } from '@sytue/i18n';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { localeFromParam, localeParams, useT } from '../../i18n';

export const getStaticPaths = localeParams;

const locale = localeFromParam(Astro.params.locale);
const t = useT(locale);

const TITULAR = {
  nombre: 'Sytue Projects, S.L.',
  nif: 'B88729900',
  domicilio: 'Calle Atenas, 10 · 28822 Coslada (Madrid) · España',
  email: 'soporte@sytue.eu',
  web: 'www.sytue.eu',
} as const;

const sections = ['scope', 'ip', 'liability', 'law'] as const;
---

<MarketingLayout
  locale={locale}
  path="/legal"
  title={t('meta.legal.title')}
  description={t('meta.legal.description')}
  alternates={LOCALES}
>
  <article class="mx-auto max-w-2xl px-6 py-16 md:py-20">
    <span class="sytue-overline text-primary-text">{t('legal.overline')}</span>
    <h1 class="sytue-h1 text-text mt-3 text-balance">{t('aviso.title')}</h1>
    <p class="text-text-muted mt-3 text-base">{t('aviso.updated')}</p>
    <div
      role="note"
      class="border-border bg-warning-bg text-warning-text mt-6 rounded-md border px-4 py-3 text-sm leading-relaxed"
    >
      <strong>{t('legal.review.title')}</strong> {t('aviso.review.body')}
    </div>

    <div class="text-text mt-8 flex flex-col gap-8 text-base leading-relaxed">
      <p class="text-text-muted">{t('aviso.intro')}</p>

      <section>
        <h2 class="sytue-h3 text-text text-balance">{t('aviso.owner.title')}</h2>
        <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-[max-content_1fr]">
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.name')}</dt>
          <dd class="text-text font-semibold">{TITULAR.nombre}</dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.form')}</dt>
          <dd>{t('aviso.owner.formValue')}</dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.nif')}</dt>
          <dd class="font-mono">{TITULAR.nif}</dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.address')}</dt>
          <dd>{TITULAR.domicilio}</dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.registry')}</dt>
          <dd>{t('aviso.owner.registryValue')}</dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.email')}</dt>
          <dd>
            <a
              href={`mailto:${TITULAR.email}`}
              class="text-primary-text font-semibold break-words hover:underline"
            >
              {TITULAR.email}
            </a>
          </dd>
          <dt class="text-text-muted text-sm sm:pt-0.5">{t('aviso.owner.web')}</dt>
          <dd>{TITULAR.web}</dd>
        </dl>
      </section>

      {sections.map((key) => (
        <section>
          <h2 class="sytue-h3 text-text text-balance">{t(`aviso.${key}.title`)}</h2>
          <p class="text-text-muted mt-2">{t(`aviso.${key}.body`)}</p>
        </section>
      ))}
    </div>
  </article>
</MarketingLayout>
