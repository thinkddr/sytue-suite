{
  "name": "@sytue/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue One — monorepo frontend (Astro 7 + Preact 10.29, Bun). Design system, shell, auth OIDC/PKCE contra Sytue ID y SDKs a los servicios Go propios. Diseño Sytue-native. Soberanía 100% UE.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "catalog": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.6",
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@lhci/cli": "0.15.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "astro": ">=7.3.5 <8",
    "eslint-plugin-astro": "3.2.1",
    "prettier-plugin-astro": "1.1.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "build:all": "bun run --filter '*' --sequential build",
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' --sequential typecheck",
    "lint": "bunx oxlint --type-aware && bunx eslint \"**/*.astro\" && bun run lint:design && bun run lint:i18n && bun run lint:rutas && bun run lint:terceros && bun run lint:marca && bun run lint:tokens",
    "lint:design": "./scripts/lint-design.sh",
    "lint:i18n": "./scripts/lint-i18n.sh",
    "lint:rutas": "./scripts/lint-rutas-base.sh",
    "lint:marca": "./scripts/lint-marca.sh",
    "lint:terceros": "./scripts/lint-terceros.sh",
    "lint:tokens": "./scripts/lint-tokens.sh",
    "format": "bunx prettier@3.9.9 --write \"**/*.{ts,tsx,astro,css,json,md}\" \"../../docs/*.md\"",
    "format:check": "bunx prettier@3.9.9 --check \"**/*.{ts,tsx,astro,css,json,md}\" \"../../docs/*.md\"",
    "clean": "bun run --filter '*' clean",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@lhci/cli": "catalog:",
    "@sytue/config": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "catalog:",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-scope": "9.1.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "astro": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier-plugin-astro": "catalog:",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "basic-ftp": "6.2.1",
    "ip-address": "10.7.2",
    "devalue": "5.9.4",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "js-yaml": "4.3.2",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.0",
    "nanoid": "3.3.20",
    "postcss": "8.5.30",
    "qs": "6.16.0",
    "svgo": "4.1.0",
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "@puppeteer/browsers": "3.2.2",
    "vite": "8.3.4"
  },
  "patchedDependencies": {
    "astro@7.3.5": "patches/astro@7.3.5.patch",
    "livekit-client@2.22.3": "patches/livekit-client@2.22.3.patch"
  }
}
