{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Sytue — paleta canónica compartida por toda la suite. Tres modos (claro, traslúcido, oscuro) por tres colores elegibles: petróleo, que es el de este fichero, azul cobalto y el de cada app, que es el predeterminado. Los dos últimos viven como bloques `data-color` en colors.css. Estados con texto e icono.",
  "meta": {
    "brand": "Sytue",
    "suite": "Sytue One",
    "version": "5.0.0"
  },
  "primary": {
    "$description": "El color de la suite, aquí petróleo — acción, selección, enlace y foco. En oscuro el relleno es el 400, con rótulo oscuro.",
    "50": "#e9f6f6",
    "100": "#d9efef",
    "200": "#aee1e4",
    "300": "#7fd3d8",
    "400": "#3cc4cc",
    "500": "#1a9aa3",
    "600": "#0f7680",
    "700": "#0c636b",
    "800": "#0a4a50",
    "900": "#083b40",
    "950": "#04262a",
    "base": "#0f7680",
    "hover": "#0c636b",
    "active": "#0a4a50",
    "on": "#ffffff",
    "text": "#0c636b",
    "$text-note": "Relleno con texto blanco: 600. Texto/enlace sobre blanco: 700. Anillo de foco: 600 en claro, 700 en traslúcido, 300 en oscuro. En oscuro el relleno es el 400 con rótulo casi negro. Los valores de cobalto están en colors.css."
  },
  "copper": {
    "$description": "Cobre — familia de datos y gráficos. Fue la señal de «estás aquí»; hoy esa señal es el token indicator. Nunca relleno con texto encima.",
    "300": "#f29c77",
    "400": "#ee7d52",
    "500": "#e06a36",
    "600": "#b44a1d",
    "700": "#963d17",
    "$text-note": "500 sobre blanco, papel y tinta (≥ 3:1); 400 sobre el cromo oscuro (≥ 4,7:1). Como relleno con texto, el 600 (5,3:1); como texto sobre claro, el 700 (7:1)."
  },
  "accent": {
    "$description": "Tinta marina — texto, cromo de la suite y acento secundario.",
    "50": "#f2f5f7",
    "100": "#e3eaee",
    "200": "#c6d3da",
    "300": "#9fb3bd",
    "400": "#6f8792",
    "500": "#4d6470",
    "600": "#36505c",
    "700": "#224656",
    "800": "#1a3541",
    "900": "#11232b",
    "950": "#0a151a",
    "base": "#1a3541",
    "hover": "#224656",
    "on": "#ffffff",
    "text": "#224656",
    "$text-note": "La tinta (800, #1a3541) es el texto de la suite: 11,9:1 sobre papel."
  },
  "violet": {
    "$description": "Acento terciario — SOLO en gráficos, etiquetas y diferenciación de datos/producto. Nunca como color de acción de UI.",
    "300": "#b8a6ff",
    "400": "#9a7eff",
    "500": "#7c5cff",
    "600": "#6740e6",
    "700": "#5430bd",
    "base": "#7c5cff",
    "on": "#ffffff",
    "text": "#5430bd",
    "$text-note": "Violeta como texto sobre superficie clara.",
    "bg": "#f0edfc",
    "bg-dark": "#27203c"
  },
  "neutral": {
    "$description": "Blanco y grises con un punto del color para superficies, líneas y texto; tonos profundos para el tema oscuro.",
    "0": "#ffffff",
    "25": "#fafcfc",
    "50": "#f6f9f9",
    "100": "#f1f6f6",
    "150": "#e8efef",
    "200": "#e0e8e8",
    "300": "#cad5d6",
    "400": "#919ea0",
    "500": "#586a6f",
    "600": "#43555a",
    "700": "#34464b",
    "800": "#283639",
    "850": "#1a2628",
    "900": "#131c1e",
    "950": "#0a1011",
    "1000": "#070c0d"
  },
  "semantic": {
    "$description": "base = relleno (badge/dot/banner con on/blanco encima). text = color como texto/icono sobre superficie clara Y sobre su propio bg (≥ 4.5:1). bg = fondo suave. text-dark = escalón claro para texto sobre superficie oscura. Nunca comunicar estado solo por color: siempre icono o texto.",
    "success": {
      "base": "#1d7443",
      "hover": "#175c35",
      "text": "#1a6a3d",
      "text-dark": "#5fd08f",
      "bg": "#e5f3eb",
      "bg-dark": "#10301f",
      "on": "#ffffff"
    },
    "warning": {
      "base": "#8a5d0c",
      "hover": "#6e4a09",
      "text": "#7f5a0f",
      "text-dark": "#e8b86a",
      "bg": "#fcf1d9",
      "bg-dark": "#33270e",
      "on": "#ffffff"
    },
    "danger": {
      "base": "#c34134",
      "hover": "#922e24",
      "text": "#a3342a",
      "text-dark": "#f08f84",
      "bg": "#fbeae7",
      "bg-dark": "#3a1a16",
      "on": "#ffffff"
    },
    "info": {
      "base": "#1a6fbb",
      "hover": "#165c9c",
      "text": "#165c9c",
      "text-dark": "#7db8ec",
      "bg": "#eaf3fb",
      "bg-dark": "#0f2a44",
      "on": "#ffffff"
    }
  },
  "presence": {
    "$description": "Indicadores de presencia (Sytue Hub) — coherentes en chat, mail, shell. Siempre con forma/icono, nunca solo color.",
    "online": "#2a8f57",
    "away": "#b27a0e",
    "dnd": "#c34134",
    "offline": "#8c847c"
  },
  "avatar": {
    "$description": "Colores de persona (avatar, autoría, cursores de coedición), fondo determinista por nombre. Vivos y bien separados en el círculo; iniciales en blanco AA (≥ 4,6:1) sobre todos.",
    "1": "#0e7c74",
    "2": "#b8466a",
    "3": "#1f6fb5",
    "4": "#b35633",
    "5": "#2a7d48",
    "6": "#6a58b8"
