{
  "name": "@sytue/offline",
  "version": "1.0.0",
  "private": true,
  "description": "Infraestructura offline-first compartida de Sytue One: IndexedDB por cuenta, conectividad, shell nativo y service worker de lectura segura.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preact": "./src/preact.ts",
