{
  "name": "@sytue/offline",
  "version": "1.0.0",
  "private": true,
  "description": "Infraestructura offline-first compartida de Sytue One: IndexedDB por cuenta, conectividad, shell nativo y service worker de lectura segura.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preact": "./src/preact.ts",
    "./worker": "./src/worker.ts",
    "./matrix": "./src/matrix/index.ts",
    "./matrix/types": "./src/matrix/types.ts",
    "./matrix/auth": "./src/matrix/auth.ts",
    "./matrix/unlock-bridge": "./src/matrix/unlock-bridge.ts",
    "./pqc/runtime": "./src/pqc/runtime.ts",
    "./session-owner": "./src/session-owner.ts",
    "./pqc/framing": "./src/pqc/host-codec.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "@sytue/api-clients": "workspace:*",
    "@sytue/config": "workspace:*",
    "another-json": "0.2.0",
    "hash-wasm": "4.12.0",
    "lossless-json": "4.3.3",
    "matrix-js-sdk": "45.0.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "6.0.3"
  }
}
