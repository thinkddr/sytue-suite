    "./matrix/types": "./src/matrix/types.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@sytue/config": "workspace:*",
    "preact": "10.29.8",
    "matrix-js-sdk": "44.0.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "6.0.3"
  }
