{
  "name": "@sytue/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Sytue One — design system (Preact 10). Componentes canonicos «Tinta y papel»: Button, Card, Sidebar, TopBar, AppGrid/Launcher, Modal, Avatar, List, Table, Toast, Tabs, Form fields, ThemeProvider. Tokens y logos desde branding/.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./assets": "./src/assets/index.ts",
    "./browser/editing": "./src/browser/editing.ts",
    "./browser/tabla": "./src/browser/tabla.ts",
    "./browser/zoom": "./src/browser/zoom.ts",
    "./icons": "./src/assets/icons.ts",
    "./pagina-404.astro": "./src/astro/PaginaNoEncontrada.astro"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@sytue/config": "workspace:*",
    "@sytue/i18n": "workspace:*",
    "@tanstack/virtual-core": "3.17.11",
    "clsx": "2.1.1",
    "preact": "10.29.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.2",
    "@types/node": "catalog:",
    "typescript": "6.0.3"
  }
}
