<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sytue_widget_background" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/sytue_widget_background">
    <TextView android:id="@+id/sytue_widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/sytue_widget_name"
        android:textSize="16sp" android:fontFamily="sans-serif-medium"
        android:textColor="@color/sytue_widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/sytue_widget_counts" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:textSize="18sp" android:textColor="@color/sytue_widget_text"
        android:maxLines="3" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/sytue_widget_open" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:gravity="center_vertical" android:text="@string/sytue_widget_open"
            android:textSize="14sp" android:textColor="@color/sytue_widget_action"
            android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/sytue_widget_search" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:gravity="center" android:text="@string/sytue_widget_search" android:textSize="14sp"
            android:textColor="@color/sytue_widget_action" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/sytue_widget_extra" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:gravity="center_vertical|end" android:textSize="14sp"
            android:textColor="@color/sytue_widget_action" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
