<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sytue_widget_background" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/sytue_widget_background">
    <LinearLayout android:id="@+id/sytue_widget_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/sytue_widget_icon" android:layout_width="20dp"
            android:layout_height="20dp" android:layout_marginEnd="7dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no"
            android:visibility="gone" />
        <TextView android:id="@+id/sytue_widget_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/sytue_widget_name" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/sytue_widget_text"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sytue_widget_badge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:background="@drawable/sytue_widget_pill"
            android:textSize="11sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/sytue_widget_action" android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/sytue_widget_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textSize="11sp" android:textColor="@color/sytue_widget_muted"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <ImageView android:id="@+id/sytue_widget_visual" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
        android:scaleType="fitCenter" android:visibility="gone" />
    <TextView android:id="@+id/sytue_widget_counts" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:textSize="15sp" android:textColor="@color/sytue_widget_muted"
        android:maxLines="3" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:id="@+id/sytue_widget_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/sytue_widget_open" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="32dp"
            android:gravity="center_vertical" android:text="@string/sytue_widget_open"
            android:textSize="12sp" android:textColor="@color/sytue_widget_action"
            android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sytue_widget_search" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="32dp"
            android:layout_marginStart="6dp" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:gravity="center" android:background="@drawable/sytue_widget_pill"
            android:text="@string/sytue_widget_search" android:textSize="12sp"
            android:textColor="@color/sytue_widget_action" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/sytue_widget_extra" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="32dp"
            android:layout_marginStart="6dp" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:gravity="center" android:background="@drawable/sytue_widget_pill"
            android:textSize="12sp" android:textColor="@color/sytue_widget_action"
            android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
