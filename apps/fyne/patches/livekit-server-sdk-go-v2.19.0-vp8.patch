+package lksdk
+
+import (
+	"crypto/cipher"
+	"errors"
+)
+
+// VP8 follows client-sdk-js v2.22.3 FrameCryptor and RFC 6386 section 9.1:
+// the frame tag (3 bytes), and additionally the keyframe header (7 bytes),
+// remain authenticated cleartext. RTP payload descriptors are outside the frame.
+func vp8HeaderBytes(sample []byte) (int, error) {
+	if len(sample) < 3 || (sample[0]>>1)&7 > 3 {
+		return 0, errors.New("invalid VP8 frame tag")
+	}
+	if sample[0]&1 != 0 {
+		return 3, nil
+	}
+	if len(sample) < 10 || sample[3] != 0x9d || sample[4] != 0x01 || sample[5] != 0x2a {
+		return 0, errors.New("invalid VP8 keyframe header")
+	}
+	return 10, nil
+}
+
+func EncryptGCMVP8SampleCustomCipher(sample []byte, kid uint8, block cipher.Block) ([]byte, error) {
+	header, err := vp8HeaderBytes(sample)
+	if err != nil {
+		return nil, err
+	}
+	if len(sample) <= header {
+		return nil, errors.New("VP8 frame has no encoded payload")
+	}
+	return encryptGCMSample(sample, kid, block, header)
+}
+func DecryptGCMVP8SampleCustomCipher(sample, sifTrailer []byte, block cipher.Block) ([]byte, error) {
+	header, err := vp8HeaderBytes(sample)
+	if err != nil {
+		return nil, err
+	}
+	return decryptGCMSample(sample, sifTrailer, block, header)
+}
