+package lksdk
+
+import (
+	"bytes"
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/server-sdk-go/v2/e2ee"
+	"github.com/pion/webrtc/v4"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+type dataPolicyHandler struct {
+	engineHandler
+	received int
+	payload  []byte
+}
+
+func (h *dataPolicyHandler) OnDataPacket(_ string, packet DataPacket) {
+	h.received++
+	h.payload = packet.(*UserDataPacket).Payload
+}
+func TestDataEncryptionPolicyBeforeHandler(t *testing.T) {
+	kp := e2ee.NewExternalKeyProvider()
+	if err := kp.SetKeyFromPassphrase("artificial-test-only-key-material", 0); err != nil {
+		t.Fatal(err)
+	}
+	dc := e2ee.NewDataCryptor(kp)
+	handler := &dataPolicyHandler{}
+	engine := &RTCEngine{dataCryptor: dc, engineHandler: handler, log: logger}
+	plaintext := []byte(`{"t":"mano","alzada":true}`)
+	packet := &livekit.DataPacket{ParticipantIdentity: "artificial-user", Value: &livekit.DataPacket_User{User: &livekit.UserPacket{Payload: plaintext}}}
+	deliver := func(packet *livekit.DataPacket) {
+		wire, err := proto.Marshal(packet)
+		if err != nil {
+			t.Fatal(err)
+		}
+		engine.handleDataPacket(webrtc.DataChannelMessage{Data: wire})
+	}
+	deliver(packet)
+	if handler.received != 0 {
+		t.Fatal("plaintext reached encrypted handler")
+	}
+	cipher, err := dc.Encrypt(packet)
+	if err != nil {
+		t.Fatal(err)
+	}
+	none := proto.Clone(cipher).(*livekit.DataPacket)
+	none.GetEncryptedPacket().EncryptionType = livekit.Encryption_NONE
+	deliver(none)
+	if handler.received != 0 {
+		t.Fatal("NONE downgrade reached encrypted handler")
+	}
+	tampered := proto.Clone(cipher).(*livekit.DataPacket)
+	tampered.GetEncryptedPacket().EncryptedValue[0] ^= 1
+	deliver(tampered)
+	if handler.received != 0 {
+		t.Fatal("tampered data reached encrypted handler")
+	}
+	deliver(cipher)
+	if handler.received != 1 || !bytes.Equal(handler.payload, plaintext) {
+		t.Fatal("GCM packet did not reach handler")
+	}
+}
