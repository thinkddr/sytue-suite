From 5a25290dbdb573e331794be64e2a3c2e94f41872 Mon Sep 17 00:00:00 2001
From: Daniel Delgado <admin@sytue.eu>
Date: Mon, 28 Sep 2026 08:41:41 +0200
Subject: [PATCH 2/2] painter/gl: keep the framebuffer alpha opaque

With srcAlpha/oneMinusSrcAlpha on the alpha channel too, every antialiased
edge left alpha below 1 over colours that are not premultiplied. A Wayland
compositor (KWin) blends the surface as premultiplied and showed coloured
fringes on every rounded or stroked edge. Colour keeps the requested factors;
alpha uses ONE for the source so it always accumulates towards 1. Checked on a
real Plasma session.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 internal/painter/gl/gl_core.go | 7 ++++++-
 internal/painter/gl/gl_es.go   | 7 ++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/internal/painter/gl/gl_core.go b/internal/painter/gl/gl_core.go
index 26631846d..106ca119a 100644
--- a/internal/painter/gl/gl_core.go
+++ b/internal/painter/gl/gl_core.go
@@ -176,7 +176,12 @@ func (c *coreContext) BlendColor(r, g, b, a float32) {
 }
 
 func (c *coreContext) BlendFunc(srcFactor, destFactor uint32) {
-	gl.BlendFunc(srcFactor, destFactor)
+	// The alpha channel of the framebuffer must stay opaque: with srcAlpha/oneMinusSrcAlpha
+	// on alpha too, every antialiased edge left alpha below 1 over colours that are not
+	// premultiplied, and a Wayland compositor (KWin), which blends the surface as
+	// premultiplied, showed coloured fringes on every rounded or stroked edge. The colour
+	// keeps the requested factors; alpha always accumulates towards 1.
+	gl.BlendFuncSeparate(srcFactor, destFactor, gl.ONE, destFactor)
 }
 
 func (c *coreContext) BufferData(target uint32, points []float32, usage uint32) {
diff --git a/internal/painter/gl/gl_es.go b/internal/painter/gl/gl_es.go
index 18e5cb49d..2e682192f 100644
--- a/internal/painter/gl/gl_es.go
+++ b/internal/painter/gl/gl_es.go
@@ -176,7 +176,12 @@ func (c *esContext) BlendColor(r, g, b, a float32) {
 }
 
