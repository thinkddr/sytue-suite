+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Daniel Delgado Ramos
+
+package mobile
+
+import (
+	"context"
+	"time"
+)
+
+// BackgroundDriver is an optional API of the mobile driver for work that the system
+// starts without a user interface. Assert it on fyne.App.Driver().
+//
+// iOS can launch an app with no scene: for an app refresh task (BGAppRefreshTask) or
+// a background notification. The whole main function runs then too, before UIKit says
+// why it launched, so an app that wants to avoid user-facing work in that case defers
+// it with OnFirstScene. Other platforms have no such launch: OnFirstScene runs at once,
+// LaunchedInBackground is false, protected data is available and no refresh is ever
+// requested.
+type BackgroundDriver interface {
+	// LaunchedInBackground reports whether the system launched the process without a
+	// user interface and no scene has connected since. It is only meaningful once the
+	// application has finished launching; before that it is false.
+	LaunchedInBackground() bool
+
+	// OnFirstScene runs f when the first scene connects: synchronously, on the main
+	// thread, before the URLs or user activities of that scene are delivered, in the
+	// order the functions were registered. If a scene has already connected, or the
+	// platform has no scenes, f runs synchronously before OnFirstScene returns.
+	// f must not block or wait for the UI goroutine.
+	OnFirstScene(f func())
+
+	// ProtectedDataAvailable reports whether files with complete data protection can
+	// be read: on iOS, false while the device is locked
+	// (UIApplication.protectedDataAvailable). It is safe from any goroutine.
+	ProtectedDataAvailable() bool
+
+	// OnBackgroundRefresh sets the handler of the app refresh task. The first entry of
+	// BGTaskSchedulerPermittedIdentifiers in Info.plist names the task, and
+	// UIBackgroundModes must contain "fetch"; without them the handler never runs.
+	//
+	// A refresh is requested no earlier than every from now each time the app moves to
+	// the background, and again when the handler returns: after every, or after retry
+	// when it is positive. f runs on its own goroutine. ctx is cancelled when the
+	// system ends the task, and the task is then reported as failed as soon as f
+	// returns, or after a grace of half a second if it does not. f must return
+	// promptly once ctx is done, and must not hold a file lock in a shared container
+	// past that: iOS suspends the app when the task completes, and kills an app that
+	// is suspended holding one (0xdead10cc).
+	// ok is the success reported to the system. Set it before the first scene connects
+	// (in main) so that a refresh launch finds it.
+	OnBackgroundRefresh(every time.Duration, f func(ctx context.Context) (ok bool, retry time.Duration))
+}
diff --git a/internal/driver/mobile/app/background.go b/internal/driver/mobile/app/background.go
new file mode 100644
index 0000000..33c4498
--- /dev/null
+++ b/internal/driver/mobile/app/background.go
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Daniel Delgado Ramos
+
+package app
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// BackgroundRefresh is the handler of the app refresh task (OnBackgroundRefresh).
+type BackgroundRefresh func(ctx context.Context) (ok bool, retry time.Duration)
+
+// backgroundState is what the platform tells about launches without a user
+// interface. Only iOS feeds it (darwin_ios.go); elsewhere the first scene is the
+// application itself and no refresh is ever requested.
+type backgroundState struct {
+	mu sync.Mutex
+	// waitsForScene: the platform can launch without a scene and connects one later.
+	waitsForScene        bool
+	sceneConnected       bool
+	launchedInBackground bool
+	firstScene           []func()
+	protectedUnavailable bool
+	every                time.Duration
+	refresh              BackgroundRefresh
+	running              map[uintptr]*refreshRun
+}
+
+// refreshRun is one refresh task the system handed to the app.
+type refreshRun struct {
+	// cancel is nil until the handler starts.
+	cancel   context.CancelFunc
+	complete func(ok bool, next time.Duration)
+	// returned is closed when the handler returns.
+	returned chan struct{}
+}
+
+// expireGrace is how long an expired task waits for its handler to return after the
+// handler's context is cancelled. iOS suspends the app as soon as the task completes,
+// and kills one suspended while holding a file lock in a shared container
+// (0xdead10cc): this gives the handler time to notice and let go.
+var expireGrace = 500 * time.Millisecond
+
+var background = &backgroundState{}
+
+// LaunchedInBackground reports whether the system launched the process without a
+// user interface and no scene has connected since.
+func LaunchedInBackground() bool { return background.launchedWithoutScene() }
+
+// OnFirstScene runs f when the first scene connects, or now if there is no scene to
+// wait for. See mobile.BackgroundDriver.
+func OnFirstScene(f func()) { background.onFirstScene(f) }
+
+// ProtectedDataAvailable reports whether files with complete data protection can be read.
+func ProtectedDataAvailable() bool { return background.protectedDataAvailable() }
+
+// OnBackgroundRefresh sets the handler of the app refresh task.
+func OnBackgroundRefresh(every time.Duration, f BackgroundRefresh) {
+	background.onBackgroundRefresh(every, f)
+}
+
+func (b *backgroundState) launchedWithoutScene() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.launchedInBackground && !b.sceneConnected
+}
+
+func (b *backgroundState) onFirstScene(f func()) {
+	if f == nil {
+		return
+	}
+	b.mu.Lock()
+	if b.waitsForScene && !b.sceneConnected {
+		b.firstScene = append(b.firstScene, f)
+		b.mu.Unlock()
+		return
+	}
+	b.mu.Unlock()
+	f()
+}
+
+func (b *backgroundState) protectedDataAvailable() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return !b.protectedUnavailable
+}
+
+func (b *backgroundState) onBackgroundRefresh(every time.Duration, f BackgroundRefresh) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if f == nil || every <= 0 {
+		b.every, b.refresh = 0, nil
+		return
+	}
+	b.every, b.refresh = every, f
+}
+
+// launchFinished records how the application finished launching.
+func (b *backgroundState) launchFinished(inBackground, protectedData bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.launchedInBackground = inBackground
+	b.protectedUnavailable = !protectedData
+}
+
+func (b *backgroundState) setProtectedData(available bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.protectedUnavailable = !available
+}
+
+// connectScene runs what waited for the first scene, in order. A function registered
+// by one of them runs at once: the scene is already there.
+func (b *backgroundState) connectScene() {
+	b.mu.Lock()
+	if b.sceneConnected {
+		b.mu.Unlock()
+		return
+	}
+	b.sceneConnected = true
+	waiting := b.firstScene
+	b.firstScene = nil
+	b.mu.Unlock()
+	for _, f := range waiting {
+		f()
+	}
+}
+
+// refreshInterval is how far ahead to request the next refresh when the app moves to
+// the background: zero without a handler.
+func (b *backgroundState) refreshInterval() time.Duration {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.every
+}
+
+// receiveRefresh records the system task `task` as soon as the system hands it over,
+// before it can expire and before startRefresh. complete is called exactly once: when
+// the handler returns, or when the task expires first (at once if the handler had not
+// started). next is when to request the following refresh; zero requests none.
+func (b *backgroundState) receiveRefresh(task uintptr, complete func(ok bool, next time.Duration)) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.running == nil {
+		b.running = map[uintptr]*refreshRun{}
+	}
+	b.running[task] = &refreshRun{complete: complete, returned: make(chan struct{})}
+}
+
+// startRefresh runs the handler for the task receiveRefresh recorded. If the task
+// already expired, it was completed then and the handler does not run.
+func (b *backgroundState) startRefresh(task uintptr) {
+	b.mu.Lock()
+	run := b.running[task]
+	if run == nil || run.cancel != nil {
+		b.mu.Unlock()
+		return // expired before it started, or already running
+	}
+	f, every := b.refresh, b.every
+	if f == nil {
+		delete(b.running, task)
+		b.mu.Unlock()
+		run.complete(false, 0)
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	run.cancel = cancel
+	b.mu.Unlock()
+	go func() {
+		ok, retry := f(ctx)
+		close(run.returned)
+		next := every
+		if retry > 0 {
+			next = retry
+		}
+		b.finishRefresh(task, ok, next)
+	}()
+}
+
+// expireRefresh is the system ending the task: the handler's context is cancelled and
+// the task fails, with the regular interval for the next one, once the handler returns
+// or expireGrace passes. It does not block its caller.
+func (b *backgroundState) expireRefresh(task uintptr) {
+	b.mu.Lock()
+	run := b.running[task]
+	delete(b.running, task)
+	var cancel context.CancelFunc
+	if run != nil {
+		cancel = run.cancel
+	}
+	next := b.every
+	b.mu.Unlock()
+	if run == nil {
+		return // already completed
+	}
+	if cancel == nil {
+		run.complete(false, next) // the handler never started: nothing to wait for
+		return
+	}
+	cancel()
+	go func() {
+		grace := time.NewTimer(expireGrace)
+		defer grace.Stop()
+		select {
+		case <-run.returned:
+		case <-grace.C:
+		}
+		run.complete(false, next)
+	}()
+}
+
+func (b *backgroundState) finishRefresh(task uintptr, ok bool, next time.Duration) {
+	b.mu.Lock()
+	run := b.running[task]
+	delete(b.running, task)
+	b.mu.Unlock()
+	if run == nil {
+		return // already completed: expired before the handler returned
+	}
+	run.cancel()
+	run.complete(ok, next)
+}
diff --git a/internal/driver/mobile/app/background_test.go b/internal/driver/mobile/app/background_test.go
new file mode 100644
index 0000000..3cf81ae
--- /dev/null
+++ b/internal/driver/mobile/app/background_test.go
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Daniel Delgado Ramos
+
+package app
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestFirstSceneRunsAtOnceWithoutScenes(t *testing.T) {
+	b := &backgroundState{}
+	ran := false
+	b.onFirstScene(func() { ran = true })
+	if !ran {
+		t.Fatal("a platform without scenes must run the function at once")
+	}
+	if b.launchedWithoutScene() {
+		t.Fatal("a platform without scenes is never launched without one")
+	}
+}
+
+func TestFirstSceneWaitsForTheSceneAndKeepsTheOrder(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	var order []string
+	b.onFirstScene(func() { order = append(order, "first") })
+	b.onFirstScene(func() {
+		order = append(order, "second")
+		// Registered while connecting: the scene is already there.
+		b.onFirstScene(func() { order = append(order, "nested") })
+	})
+	b.launchFinished(true, true)
+	if len(order) != 0 {
+		t.Fatalf("ran before any scene: %v", order)
+	}
+	if !b.launchedWithoutScene() {
+		t.Fatal("a background launch without a scene is not reported")
+	}
+	b.connectScene()
+	if want := []string{"first", "second", "nested"}; !slices.Equal(order, want) {
+		t.Fatalf("got %v, want %v", order, want)
+	}
+	if b.launchedWithoutScene() {
+		t.Fatal("still reported as without scene after one connected")
+	}
+	b.connectScene()
+	b.onFirstScene(func() { order = append(order, "late") })
+	if want := []string{"first", "second", "nested", "late"}; !slices.Equal(order, want) {
+		t.Fatalf("a second scene or a late registration: got %v, want %v", order, want)
+	}
+}
+
+func TestProtectedDataFollowsThePlatform(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	if !b.protectedDataAvailable() {
+		t.Fatal("protected data must be assumed available until the platform says otherwise")
+	}
+	b.launchFinished(true, false)
+	if b.protectedDataAvailable() {
+		t.Fatal("a launch with the device locked reports protected data")
+	}
+	b.setProtectedData(true)
+	if !b.protectedDataAvailable() {
+		t.Fatal("unlocking is not seen")
+	}
+}
+
+type completion struct {
+	ok   bool
+	next time.Duration
+}
+
+func TestRefreshWithoutHandlerFailsWithoutRescheduling(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	got := make(chan completion, 2)
+	b.receiveRefresh(1, func(ok bool, next time.Duration) { got <- completion{ok, next} })
+	b.startRefresh(1)
+	if c := <-got; c.ok || c.next != 0 {
+		t.Fatalf("got %+v, want a failure that requests nothing", c)
+	}
+	if b.refreshInterval() != 0 {
+		t.Fatal("an app without a handler must not request refreshes")
+	}
+}
+
+func TestRefreshCompletesWithTheHandlerResult(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	retry := time.Duration(0)
+	b.onBackgroundRefresh(30*time.Minute, func(context.Context) (bool, time.Duration) { return true, retry })
+	if b.refreshInterval() != 30*time.Minute {
+		t.Fatal("the interval is not the one registered")
+	}
+	got := make(chan completion, 2)
+	done := func(ok bool, next time.Duration) { got <- completion{ok, next} }
+	b.receiveRefresh(1, done)
+	b.startRefresh(1)
+	if c := <-got; !c.ok || c.next != 30*time.Minute {
+		t.Fatalf("got %+v, want success and the regular interval", c)
+	}
+	retry = 5 * time.Minute
+	b.receiveRefresh(2, done)
+	b.startRefresh(2)
+	if c := <-got; !c.ok || c.next != 5*time.Minute {
+		t.Fatalf("got %+v, want the handler's retry", c)
+	}
+}
+
+func TestExpiredRefreshCancelsAndCompletesOnce(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	started, released := make(chan struct{}), make(chan struct{})
+	b.onBackgroundRefresh(time.Hour, func(ctx context.Context) (bool, time.Duration) {
+		close(started)
+		<-ctx.Done()
+		<-released
+		return true, time.Minute
+	})
+	got := make(chan completion, 2)
+	b.receiveRefresh(7, func(ok bool, next time.Duration) { got <- completion{ok, next} })
+	b.startRefresh(7)
+	<-started
+	b.expireRefresh(7)
+	if c := <-got; c.ok || c.next != time.Hour {
+		t.Fatalf("got %+v, want a failure now, with the regular interval", c)
+	}
+	close(released) // the handler returns late: nothing else is reported
+	time.Sleep(20 * time.Millisecond)
+	select {
+	case c := <-got:
+		t.Fatalf("the task completed twice: %+v", c)
+	default:
+	}
+	b.expireRefresh(7) // an expiration after completion is ignored
+	select {
+	case c := <-got:
+		t.Fatalf("an expiration after completion was reported: %+v", c)
+	default:
+	}
+}
+
+func TestExpiredRefreshWaitsForTheHandlerToLetGo(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	started := make(chan struct{})
+	var letGo time.Time
+	b.onBackgroundRefresh(time.Hour, func(ctx context.Context) (bool, time.Duration) {
+		close(started)
+		<-ctx.Done()
+		time.Sleep(50 * time.Millisecond) // releasing a lock in the shared container
+		letGo = time.Now()
+		return true, time.Minute
+	})
+	got := make(chan time.Time, 2)
+	var c completion
+	b.receiveRefresh(8, func(ok bool, next time.Duration) {
+		c = completion{ok, next}
+		got <- time.Now()
+	})
+	b.startRefresh(8)
+	<-started
+	b.expireRefresh(8)
+	done := <-got
+	if done.Before(letGo) || letGo.IsZero() {
+		t.Fatal("the task completed before the handler let go")
+	}
+	if c.ok || c.next != time.Hour {
+		t.Fatalf("got %+v, want a failure with the regular interval, whatever the handler says", c)
+	}
+	select {
+	case <-got:
+		t.Fatal("the task completed twice")
+	case <-time.After(20 * time.Millisecond):
+	}
+}
+
+func TestExpiredRefreshDoesNotWaitForeverForTheHandler(t *testing.T) {
+	defer func(g time.Duration) { expireGrace = g }(expireGrace)
+	expireGrace = 30 * time.Millisecond
+	b := &backgroundState{waitsForScene: true}
+	stuck := make(chan struct{})
+	defer close(stuck)
+	b.onBackgroundRefresh(time.Hour, func(context.Context) (bool, time.Duration) {
+		<-stuck
+		return true, 0
+	})
+	got := make(chan completion, 1)
+	b.receiveRefresh(9, func(ok bool, next time.Duration) { got <- completion{ok, next} })
+	b.startRefresh(9)
+	b.expireRefresh(9)
+	select {
+	case c := <-got:
+		if c.ok {
+			t.Fatalf("got %+v, want a failure", c)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("an expired task waited for a handler that never returns")
+	}
+}
+
+// The expiration handler is set before the handler starts on the main thread: an
+// expiration that comes first completes the task at once, and the handler never runs.
+func TestRefreshExpiredBeforeItStarts(t *testing.T) {
+	b := &backgroundState{waitsForScene: true}
+	ran := false
+	b.onBackgroundRefresh(time.Hour, func(context.Context) (bool, time.Duration) {
+		ran = true
+		return true, 0
+	})
+	got := make(chan completion, 2)
+	b.receiveRefresh(10, func(ok bool, next time.Duration) { got <- completion{ok, next} })
+	b.expireRefresh(10)
+	select {
+	case c := <-got:
+		if c.ok || c.next != time.Hour {
+			t.Fatalf("got %+v, want a failure with the regular interval", c)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("a task that expired before its handler started was not completed")
+	}
+	b.startRefresh(10)
+	time.Sleep(20 * time.Millisecond)
+	if ran {
+		t.Fatal("the handler ran for a task that had already expired")
+	}
+	select {
+	case c := <-got:
+		t.Fatalf("the task completed twice: %+v", c)
+	default:
+	}
+}
+
+func TestClearingTheRefreshHandler(t *testing.T) {
+	b := &backgroundState{}
+	b.onBackgroundRefresh(time.Hour, func(context.Context) (bool, time.Duration) { return true, 0 })
+	b.onBackgroundRefresh(time.Hour, nil)
+	if b.refreshInterval() != 0 {
+		t.Fatal("a nil handler must stop requesting refreshes")
+	}
+}
+
+// The native side cannot be compiled on Linux: these contracts pin what it must do.
+func TestIOSBackgroundRefreshBridge(t *testing.T) {
+	m := string(iosGeometrySource(t, "darwin_ios.m"))
+	for _, required := range []string{
+		"#import <BackgroundTasks/BackgroundTasks.h>",
+		"objectForInfoDictionaryKey:@\"BGTaskSchedulerPermittedIdentifiers\"",
+		"registerForTaskWithIdentifier:identifier usingQueue:nil launchHandler:",
+		"task.expirationHandler = ^{",
+		"backgroundRefreshReceived(handle);",
+		"backgroundRefreshStarted(handle)",
+		"backgroundRefreshExpired(handle)",
+		"[task setTaskCompleted:ok ? YES : NO]",
+		"BGAppRefreshTaskRequest alloc",
+		"submitTaskRequest:request error:&error",
+		"launchFinished(application.applicationState == UIApplicationStateBackground, application.isProtectedDataAvailable)",
+		"applicationProtectedDataWillBecomeUnavailable",
+		"applicationProtectedDataDidBecomeAvailable",
+		"scheduleBackgroundRefresh(backgroundRefreshInterval())",
+	} {
+		if !strings.Contains(m, required) {
+			t.Errorf("darwin_ios.m is missing %q", required)
+		}
+	}
+	// Each task asks UIKit whether protected data is available before the handler runs:
+	// the delegate notifications can reach a suspended app late.
+	handler := sourceSection(t, m, "launchHandler:", "}];")
+	if p, s := strings.Index(handler, "protectedDataChanged([UIApplication sharedApplication].isProtectedDataAvailable);"), strings.Index(handler, "backgroundRefreshStarted(handle);"); p < 0 || s < 0 || p > s {
+		t.Error("the launch handler must refresh protected data availability before starting the handler")
+	}
+	// Go knows the task before it can expire: an expiration that beats the main thread
+	// completes it instead of being lost.
