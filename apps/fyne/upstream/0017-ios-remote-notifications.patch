diff --git a/internal/driver/mobile/app/darwin_ios.m b/internal/driver/mobile/app/darwin_ios.m
index 79de9ca..4f551c9 100644
--- a/internal/driver/mobile/app/darwin_ios.m
+++ b/internal/driver/mobile/app/darwin_ios.m
@@ -15,6 +15,7 @@
 #import <GLKit/GLKit.h>
 #import <UserNotifications/UserNotifications.h>
 #import <BackgroundTasks/BackgroundTasks.h>
+#import <objc/runtime.h>
 
 struct utsname sysInfo;
 
@@ -87,6 +88,38 @@ static void scheduleBackgroundRefresh(double seconds) {
 	}
 }
 
+// Background remote notifications (mobile.RemoteNotificationDriver): the app declares
+// the mode in UIBackgroundModes, and the bundle is readable before UIKit launches.
+bool remoteNotificationsDeclared(void) {
+	NSArray *modes = [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIBackgroundModes"];
+	return [modes isKindOfClass:[NSArray class]] && [modes containsObject:@"remote-notification"];
+}
+
+// No permission prompt: a background notification shows nothing. The token arrives in
+// the delegate, as remoteTokenReceived.
+void registerForRemoteNotifications(void) {
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[[UIApplication sharedApplication] registerForRemoteNotifications];
+	});
+}
+
+// Called exactly once per notification by Go (remote.go), with RemoteNewData, RemoteNoData
+// or RemoteFailed; it releases the copy of the completion handler made when it arrived
+// (no ARC in this file: cgo compiles it without).
+void completeRemoteNotification(uintptr_t handle, int result) {
+	dispatch_async(dispatch_get_main_queue(), ^{
+		void (^completion)(UIBackgroundFetchResult) = (void (^)(UIBackgroundFetchResult))(void *)handle;
+		UIBackgroundFetchResult r = UIBackgroundFetchResultFailed;
+		if (result == 0) {
+			r = UIBackgroundFetchResultNewData;
+		} else if (result == 1) {
+			r = UIBackgroundFetchResultNoData;
+		}
+		completion(r);
+		[completion release];
+	});
+}
+
 void completeBackgroundRefresh(uintptr_t handle, bool ok, double next) {
 	dispatch_async(dispatch_get_main_queue(), ^{
 		BGTask *task = (BGTask *)CFBridgingRelease((CFTypeRef)handle);
@@ -124,6 +157,31 @@ void completeBackgroundRefresh(uintptr_t handle, bool ok, double next) {
 	return YES;
 }
 
+- (void)application:(UIApplication *)application didRegisterForRemoteNotificationsWithDeviceToken:(NSData *)deviceToken {
+	const unsigned char *bytes = deviceToken.bytes;
+	NSMutableString *hex = [NSMutableString stringWithCapacity:deviceToken.length * 2];
+	for (NSUInteger i = 0; i < deviceToken.length; i++) {
+		[hex appendFormat:@"%02x", bytes[i]];
+	}
+	remoteTokenReceived((char *)[hex UTF8String], NULL);
+}
+
+- (void)application:(UIApplication *)application didFailToRegisterForRemoteNotificationsWithError:(NSError *)error {
+	remoteTokenReceived(NULL, (char *)[[error localizedDescription] UTF8String]);
+}
+
+// A background notification: the payload is never read (the app fetches what changed from
+// its own servers). Protected data is asked for here, on the main thread, as the delegate's
+// notifications can reach a suspended app late.
+// It is application:didReceiveRemoteNotification:fetchCompletionHandler: only in an app
+// that declares the background mode (runApp adds it then): elsewhere UIKit would see the
+// method, warn that the mode is missing and wake the app for nothing.
+- (void)goApplication:(UIApplication *)application didReceiveRemoteNotification:(NSDictionary *)userInfo fetchCompletionHandler:(void (^)(UIBackgroundFetchResult))completionHandler {
+	protectedDataChanged(application.isProtectedDataAvailable);
+	// The copy is the one reference completeRemoteNotification releases.
+	remoteNotificationReceived((uintptr_t)(void *)[completionHandler copy]);
+}
+
 - (void)applicationProtectedDataWillBecomeUnavailable:(UIApplication *)application {
 	protectedDataChanged(false);
 }
@@ -484,6 +542,12 @@ static void sendTouches(int change, NSSet* touches, UIView *view) {
 void runApp(void) {
 	char * argv[] = {};
 	@autoreleasepool {
+		// Before UIKit looks at the delegate: see goApplication:didReceiveRemoteNotification:.
+		if (remoteNotificationsDeclared()) {
+			Method m = class_getInstanceMethod([GoAppAppDelegate class], @selector(goApplication:didReceiveRemoteNotification:fetchCompletionHandler:));
+			class_addMethod([GoAppAppDelegate class], @selector(application:didReceiveRemoteNotification:fetchCompletionHandler:),
+				method_getImplementation(m), method_getTypeEncoding(m));
+		}
 		UIApplicationMain(0, argv, nil, NSStringFromClass([GoAppAppDelegate class]));
 	}
 }
diff --git a/internal/driver/mobile/app/remote.go b/internal/driver/mobile/app/remote.go
new file mode 100644
index 0000000..f93b8d7
--- /dev/null
+++ b/internal/driver/mobile/app/remote.go
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Daniel Delgado Ramos
+
+package app
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// RemoteNotification is the handler of background remote notifications
+// (OnRemoteNotification).
+type RemoteNotification func(ctx context.Context) (newData, ok bool)
+
+// RemoteResult is what a background remote notification reports to the system.
+type RemoteResult int
+
+const (
+	// RemoteNewData: the handler fetched something new.
+	RemoteNewData RemoteResult = iota
+	// RemoteNoData: it worked and there was nothing new.
+	RemoteNoData
+	// RemoteFailed: it failed, timed out or there was no handler.
+	RemoteFailed
+)
+
+// RemoteNotificationTime is how long a handler has before its context is cancelled. iOS
+// gives the app about 30 seconds to call the completion handler; this leaves room for
+// the grace and for the main thread.
+var RemoteNotificationTime = 25 * time.Second
+
+// ErrRemoteNotificationsUnavailable is the registration error where the app cannot
+// receive background remote notifications.
+var ErrRemoteNotificationsUnavailable = errors.New("remote notifications are not available")
+
+// remoteState is what the platform tells about background remote notifications. Only
+// iOS feeds it (darwin_ios.go); elsewhere declared and register stay nil.
+type remoteState struct {
+	mu sync.Mutex
+	// declared reports whether the app declares the background mode; register asks the
+	// system for a token, which arrives later through tokenReceived.
+	declared func() bool
+	register func()
+	waiting  []func(string, error)
+	handler  RemoteNotification
+}
+
+var remote = &remoteState{}
+
+// RemoteNotificationsAvailable reports whether the app declares the remote-notification
+// background mode.
+func RemoteNotificationsAvailable() bool { return remote.available() }
+
+// RegisterForRemoteNotifications asks the system for the device token.
+func RegisterForRemoteNotifications(f func(token string, err error)) { remote.registerToken(f) }
+
+// OnRemoteNotification sets the handler of background remote notifications.
+func OnRemoteNotification(f RemoteNotification) { remote.onNotification(f) }
+
+func (r *remoteState) available() bool {
+	r.mu.Lock()
+	declared := r.declared
+	r.mu.Unlock()
+	return declared != nil && declared()
+}
+
+func (r *remoteState) registerToken(f func(string, error)) {
+	if f == nil {
+		return
+	}
+	if !r.available() {
+		go f("", ErrRemoteNotificationsUnavailable)
+		return
+	}
+	r.mu.Lock()
+	r.waiting = append(r.waiting, f)
+	first, register := len(r.waiting) == 1, r.register
+	r.mu.Unlock()
+	if first && register != nil {
+		register() // one request answers every caller waiting for it
+	}
+}
+
+func (r *remoteState) onNotification(f RemoteNotification) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.handler = f
+}
+
+// tokenReceived is the system's answer to the registration: a token or an error.
+func (r *remoteState) tokenReceived(token string, err error) {
+	r.mu.Lock()
+	waiting := r.waiting
+	r.waiting = nil
+	r.mu.Unlock()
+	for _, f := range waiting {
+		go f(token, err)
+	}
+}
+
+// receiveNotification runs the handler for one notification and calls complete exactly
+// once: with what the handler returned, or failed when it times out (after the grace) or
+// when there is no handler. It does not block its caller.
+func (r *remoteState) receiveNotification(complete func(RemoteResult)) {
+	r.mu.Lock()
+	f := r.handler
+	r.mu.Unlock()
+	if f == nil {
+		complete(RemoteFailed)
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), RemoteNotificationTime)
+	graceAfter := expireGrace
+	var once sync.Once
+	finish := func(res RemoteResult) { once.Do(func() { complete(res) }) }
+	returned := make(chan struct{})
+	go func() {
+		defer cancel()
+		newData, ok := f(ctx)
+		close(returned)
+		switch {
+		case !ok || ctx.Err() != nil:
+			finish(RemoteFailed)
+		case newData:
+			finish(RemoteNewData)
+		default:
+			finish(RemoteNoData)
+		}
+	}()
+	go func() {
+		<-ctx.Done()
+		grace := time.NewTimer(graceAfter)
+		defer grace.Stop()
+		select {
+		case <-returned:
+		case <-grace.C:
+			finish(RemoteFailed)
+		}
+	}()
+}
diff --git a/internal/driver/mobile/app/remote_test.go b/internal/driver/mobile/app/remote_test.go
new file mode 100644
index 0000000..50e9e5d
--- /dev/null
+++ b/internal/driver/mobile/app/remote_test.go
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Daniel Delgado Ramos
+
+package app
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func withRemoteTime(t *testing.T, d, grace time.Duration) {
+	t.Helper()
+	old, oldGrace := RemoteNotificationTime, expireGrace
+	RemoteNotificationTime, expireGrace = d, grace
+	t.Cleanup(func() { RemoteNotificationTime, expireGrace = old, oldGrace })
+}
+
+type completions struct {
+	mu   sync.Mutex
+	got  []RemoteResult
+	done chan struct{}
+}
+
+func newCompletions() *completions { return &completions{done: make(chan struct{}, 4)} }
+
+func (c *completions) complete(r RemoteResult) {
+	c.mu.Lock()
+	c.got = append(c.got, r)
+	c.mu.Unlock()
+	c.done <- struct{}{}
+}
+
+func (c *completions) wait(t *testing.T) []RemoteResult {
+	t.Helper()
+	select {
+	case <-c.done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the notification was never completed")
+	}
+	time.Sleep(50 * time.Millisecond) // a second completion would land here
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]RemoteResult(nil), c.got...)
+}
+
+func TestRemoteNotificationReportsWhatTheHandlerReturned(t *testing.T) {
+	for _, tc := range []struct {
+		newData, ok bool
+		want        RemoteResult
+	}{{true, true, RemoteNewData}, {false, true, RemoteNoData}, {true, false, RemoteFailed}} {
+		r := &remoteState{handler: func(context.Context) (bool, bool) { return tc.newData, tc.ok }}
+		c := newCompletions()
+		r.receiveNotification(c.complete)
+		if got := c.wait(t); len(got) != 1 || got[0] != tc.want {
+			t.Fatalf("(%v, %v) completed %v, want once %v", tc.newData, tc.ok, got, tc.want)
+		}
+	}
+}
+
+func TestRemoteNotificationWithoutHandlerFailsAtOnce(t *testing.T) {
+	c := newCompletions()
+	(&remoteState{}).receiveNotification(c.complete)
+	if got := c.wait(t); len(got) != 1 || got[0] != RemoteFailed {
+		t.Fatalf("completed %v, want once failed", got)
+	}
+}
+
+// A handler that ignores its context still lets the notification complete, after the
+// grace: iOS kills an app that never calls the completion handler.
+func TestRemoteNotificationThatOverrunsCompletesOnceAsFailed(t *testing.T) {
+	withRemoteTime(t, 20*time.Millisecond, 20*time.Millisecond)
+	release := make(chan struct{})
+	r := &remoteState{handler: func(context.Context) (bool, bool) { <-release; return true, true }}
+	c := newCompletions()
+	r.receiveNotification(c.complete)
+	select {
+	case <-c.done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the notification was never completed")
+	}
+	close(release) // the handler returns late: it must not complete a second time
+	c.done <- struct{}{}
+	if got := c.wait(t); len(got) != 1 || got[0] != RemoteFailed {
+		t.Fatalf("completed %v, want once failed", got)
+	}
+}
+
+// One that notices the cancellation and returns in time is failed too, but only once.
+func TestRemoteNotificationCancelledReturnsFailedOnce(t *testing.T) {
+	withRemoteTime(t, 20*time.Millisecond, time.Second)
+	r := &remoteState{handler: func(ctx context.Context) (bool, bool) { <-ctx.Done(); return true, true }}
+	c := newCompletions()
+	r.receiveNotification(c.complete)
+	if got := c.wait(t); len(got) != 1 || got[0] != RemoteFailed {
+		t.Fatalf("completed %v, want once failed", got)
+	}
+}
+
+func TestRemoteTokenGoesToEveryoneWaitingAndAsksOnce(t *testing.T) {
+	asked := 0
+	r := &remoteState{declared: func() bool { return true }, register: func() { asked++ }}
+	got := make(chan string, 2)
+	for range 2 {
+		r.registerToken(func(token string, err error) { got <- token })
+	}
+	if asked != 1 {
+		t.Fatalf("asked the system %d times, want once", asked)
+	}
+	r.tokenReceived("ab01", nil)
+	for range 2 {
+		select {
+		case tok := <-got:
+			if tok != "ab01" {
+				t.Fatalf("token %q", tok)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("a caller never got the token")
+		}
+	}
+	r.registerToken(func(string, error) {})
+	if asked != 2 {
+		t.Fatal("a later registration asks again: the token can change")
+	}
+}
+
+func TestRemoteNotificationsUnavailableFailRegistration(t *testing.T) {
+	for _, r := range []*remoteState{{}, {declared: func() bool { return false }}} {
+		errs := make(chan error, 1)
+		r.registerToken(func(_ string, err error) { errs <- err })
+		select {
+		case err := <-errs:
+			if !errors.Is(err, ErrRemoteNotificationsUnavailable) {
+				t.Fatalf("err = %v", err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("registration never answered")
+		}
+	}
+}
+
+// The native side cannot be compiled on Linux: these contracts pin what it must do.
+func TestIOSRemoteNotificationBridge(t *testing.T) {
+	m := string(iosGeometrySource(t, "darwin_ios.m"))
+	for _, required := range []string{
+		`objectForInfoDictionaryKey:@"UIBackgroundModes"`,
+		`containsObject:@"remote-notification"`,
+		"[[UIApplication sharedApplication] registerForRemoteNotifications];",
+		"didRegisterForRemoteNotificationsWithDeviceToken:(NSData *)deviceToken",
+		`[hex appendFormat:@"%02x", bytes[i]];`,
+		"remoteTokenReceived((char *)[hex UTF8String], NULL);",
+		"didFailToRegisterForRemoteNotificationsWithError:(NSError *)error",
+		"remoteTokenReceived(NULL, (char *)[[error localizedDescription] UTF8String]);",
+		"didReceiveRemoteNotification:(NSDictionary *)userInfo fetchCompletionHandler:(void (^)(UIBackgroundFetchResult))completionHandler",
+		"remoteNotificationReceived((uintptr_t)(void *)[completionHandler copy]);",
+		"completion(r);\n\t\t[completion release];",
+		"UIBackgroundFetchResultNewData", "UIBackgroundFetchResultNoData", "UIBackgroundFetchResultFailed",
+	} {
+		if !strings.Contains(m, required) {
+			t.Errorf("darwin_ios.m is missing %q", required)
+		}
+	}
+	// The payload is never handed to the app, and protected data is asked for before
+	// the handler runs.
+	recv := sourceSection(t, m, "didReceiveRemoteNotification:(NSDictionary *)userInfo", "\n}\n")
+	if strings.Contains(recv, "userInfo[") || strings.Contains(recv, "objectForKey") {
+		t.Error("the notification payload must not be read")
+	}
+	if p, r := strings.Index(recv, "protectedDataChanged(application.isProtectedDataAvailable);"), strings.Index(recv, "remoteNotificationReceived("); p < 0 || r < 0 || p > r {
+		t.Error("protected data availability must be refreshed before the handler starts")
+	}
+	// Only an app that declares the mode has the delegate method: UIKit warns about one
+	// that does not and would wake it for nothing. runApp adds it before UIKit starts.
+	if strings.Contains(m, "- (void)application:(UIApplication *)application didReceiveRemoteNotification:") {
+		t.Error("the delegate must not implement didReceiveRemoteNotification for every app")
+	}
+	run := sourceSection(t, m, "void runApp(void) {", "\n}\n")
+	if d, a, u := strings.Index(run, "if (remoteNotificationsDeclared()) {"),
+		strings.Index(run, "class_addMethod([GoAppAppDelegate class], @selector(application:didReceiveRemoteNotification:fetchCompletionHandler:),"),
+		strings.Index(run, "UIApplicationMain("); d < 0 || a < d || u < a {
+		t.Error("runApp must add didReceiveRemoteNotification, only with the background mode, before UIApplicationMain")
+	}
+	if !strings.Contains(m, "@selector(goApplication:didReceiveRemoteNotification:fetchCompletionHandler:)") ||
+		!strings.Contains(m, "- (void)goApplication:(UIApplication *)application didReceiveRemoteNotification:(NSDictionary *)userInfo") {
+		t.Error("the method runApp adds must be the delegate's goApplication:didReceiveRemoteNotification:fetchCompletionHandler:")
+	}
+	// The results Go sends are the order of RemoteResult.
+	if RemoteNewData != 0 || RemoteNoData != 1 || RemoteFailed != 2 {
+		t.Fatal("RemoteResult changed: completeRemoteNotification maps 0, 1 and 2")
+	}
+	g := string(iosGeometrySource(t, "darwin_ios.go"))
+	for _, required := range []string{
+		"//export remoteTokenReceived", "//export remoteNotificationReceived",
+		"remote.declared = func() bool { return bool(C.remoteNotificationsDeclared()) }",
+		"remote.register = func() { C.registerForRemoteNotifications() }",
+		"C.completeRemoteNotification(handler, C.int(r))",
+	} {
+		if !strings.Contains(g, required) {
+			t.Errorf("darwin_ios.go is missing %q", required)
+		}
+	}
+}
