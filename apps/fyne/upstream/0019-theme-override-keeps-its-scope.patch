@@ -52,7 +61,7 @@ func (t *ThemeOverride) Refresh() {
 		t.holder.Refresh()
 	}
 
-	cache.OverrideTheme(t.Content, addFeatures(t.Theme, t))
+	t.themeScope().Apply(t.Content)
 	t.Content.Refresh()
