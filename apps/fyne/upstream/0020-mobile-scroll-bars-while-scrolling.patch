 internal/widget/scroller_behavior_other.go |   5 +-
 internal/widget/scroller_mobile.go         |  12 ++-
 internal/widget/scroller_mobile_test.go    | 100 +++++++++++++++++++++
 4 files changed, 156 insertions(+), 15 deletions(-)
