diff --git a/internal/driver/mobile/app/keymodifiers.go b/internal/driver/mobile/app/keymodifiers.go
new file mode 100644
index 000000000..44633ac9a
--- /dev/null
+++ b/internal/driver/mobile/app/keymodifiers.go
@@ -0,0 +1,66 @@
+package app
+
+import (
+	"strconv"
+
+	"fyne.io/fyne/v2/internal/driver/mobile/event/key"
+)
+
+// Android meta state flags (AMETA_* in android/input.h). The *_ON flags are set
+// whenever either the left or the right key is down.
+const (
+	androidMetaShiftOn = 0x01
+	androidMetaAltOn   = 0x02
+	androidMetaCtrlOn  = 0x1000
+	androidMetaMetaOn  = 0x10000
+)
+
+// keyModifiers maps the meta state of an Android key event to key modifiers.
+//
+// They used to be left unset ("TODO(crawshaw): set Modifiers"), so a key pressed
+// with Ctrl, Alt or Meta on a hardware keyboard arrived as the bare key: Ctrl+Up
+// was Up, and Ctrl+C was C.
+func keyModifiers(meta int32) key.Modifiers {
+	var m key.Modifiers
+	if meta&androidMetaShiftOn != 0 {
+		m |= key.ModShift
+	}
+	if meta&androidMetaCtrlOn != 0 {
+		m |= key.ModControl
+	}
+	if meta&androidMetaAltOn != 0 {
+		m |= key.ModAlt
+	}
+	if meta&androidMetaMetaOn != 0 {
+		m |= key.ModMeta
+	}
+	return m
+}
+
+// isModifierKey reports whether the key is a modifier key itself.
+func isModifierKey(c key.Code) bool {
+	switch c {
+	case key.CodeLeftControl, key.CodeRightControl, key.CodeLeftShift, key.CodeRightShift,
+		key.CodeLeftAlt, key.CodeRightAlt, key.CodeLeftGUI, key.CodeRightGUI:
+		return true
+	}
+	return false
+}
+
+// keyIsShortcut reports whether the driver delivers this key as a shortcut rather
+// than typing it: it is held with Control or Meta, or with Alt without producing a
+// character. A character produced with Alt alone is typing - AltGr, which Android
+// reports as Alt, writes "@" or "€" on many European layouts.
+//
+// Android must not also hand such a key to the hidden EditText behind the soft
+// keyboard: it would apply Ctrl+V or Ctrl+A to it, and a paste would arrive twice,
+// once as the shortcut and once through the text watcher.
+func keyIsShortcut(k key.Event) bool {
+	if isModifierKey(k.Code) {
+		return false
+	}
+	if k.Modifiers&(key.ModControl|key.ModMeta) != 0 {
+		return true
+	}
+	return k.Modifiers&key.ModAlt != 0 && !strconv.IsPrint(k.Rune)
+}
diff --git a/internal/driver/mobile/app/keymodifiers_test.go b/internal/driver/mobile/app/keymodifiers_test.go
new file mode 100644
index 000000000..37380ee1b
--- /dev/null
+++ b/internal/driver/mobile/app/keymodifiers_test.go
@@ -0,0 +1,45 @@
+package app
+
+import (
+	"testing"
+
+	"fyne.io/fyne/v2/internal/driver/mobile/event/key"
+)
+
+func TestKeyModifiers(t *testing.T) {
+	for meta, want := range map[int32]key.Modifiers{
+		0:                     0,
+		0x01 | 0x40:           key.ModShift,   // AMETA_SHIFT_ON | AMETA_SHIFT_LEFT_ON
+		0x1000 | 0x2000:       key.ModControl, // AMETA_CTRL_ON | AMETA_CTRL_LEFT_ON
+		0x02 | 0x20:           key.ModAlt,     // AMETA_ALT_ON | AMETA_ALT_RIGHT_ON (AltGr)
+		0x10000 | 0x20000:     key.ModMeta,    // AMETA_META_ON | AMETA_META_LEFT_ON
+		0x1000 | 0x01:         key.ModControl | key.ModShift,
+		0x100000 | 0x200000:   0, // AMETA_CAPS_LOCK_ON | AMETA_NUM_LOCK_ON are not modifiers
+		0x1000 | 0x02 | 0x200: key.ModControl | key.ModAlt,
+	} {
+		if got := keyModifiers(meta); got != want {
+			t.Errorf("meta %#x gives %v, want %v", meta, got, want)
+		}
+	}
+}
+
+func TestKeyIsShortcut(t *testing.T) {
+	for _, c := range []struct {
+		name string
+		ev   key.Event
+		want bool
+	}{
+		{"up", key.Event{Rune: -1, Code: key.CodeUpArrow}, false},
+		{"ctrl+up", key.Event{Rune: -1, Code: key.CodeUpArrow, Modifiers: key.ModControl}, true},
+		{"ctrl+v", key.Event{Rune: -1, Code: key.CodeV, Modifiers: key.ModControl}, true},
+		{"meta+c", key.Event{Rune: -1, Code: key.CodeC, Modifiers: key.ModMeta}, true},
+		{"alt+up", key.Event{Rune: -1, Code: key.CodeUpArrow, Modifiers: key.ModAlt}, true},
+		{"altgr+2 types @", key.Event{Rune: '@', Code: key.Code2, Modifiers: key.ModAlt}, false},
+		{"shift+a types A", key.Event{Rune: 'A', Code: key.CodeA, Modifiers: key.ModShift}, false},
+		{"ctrl alone", key.Event{Rune: -1, Code: key.CodeLeftControl, Modifiers: key.ModControl}, false},
+	} {
+		if got := keyIsShortcut(c.ev); got != c.want {
+			t.Errorf("%s: keyIsShortcut = %v, want %v", c.name, got, c.want)
+		}
+	}
+}
