+        if (data->lpVtbl->GetData(data, &fe, &medium) == S_OK)
+        {
+            inputDropHDROP(window, (HDROP) medium.hGlobal, point);
+            ReleaseStgMedium(&medium);
+        }
+    }
+    else if (kind == DROP_TEXT)
+    {
+        char* url = dropString(data, dropURLFormat());
+        if (url && url[0])
