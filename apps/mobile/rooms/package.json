{
  "name": "@sytue/mobile-rooms",
  "version": "0.1.0",
  "packageManager": "bun@1.4.3",
  "private": true,
  "description": "Sytue Rooms — app movil (Capacitor 8, MIT). Shell nativo iOS/Android que envuelve la misma web de Rooms (apps/frontend/apps/rooms, rooms.sytue.eu) sin reimplementar la UI. Standalone a proposito fuera del workspace Bun del frontend: solo necesita la CLI de Capacitor + plugins.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.8.1 <27",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/selfcheck.cjs",
    "check": "node --check www/native.js && bun run typecheck && bun run test",
    "sync": "node ../scripts/cap.mjs sync",
    "add:ios": "node ../scripts/cap.mjs add ios",
    "add:android": "node ../scripts/cap.mjs add android",
    "open:ios": "node ../scripts/cap.mjs open ios",
    "open:android": "node ../scripts/cap.mjs open android",
    "run:ios": "node ../scripts/cap.mjs run ios",
    "run:android": "node ../scripts/cap.mjs run android",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0A0A0A' --splashBackgroundColor '#faf9f6' --splashBackgroundColorDark '#0c0e10'",
    "deeplinks": "bash scripts/setup-deeplinks.sh",
    "cap": "node ../scripts/cap.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-badge": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@types/node": "26.6.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@capacitor/assets": {
      "@capacitor/cli": "8.5.2",
      "@trapezedev/project": "7.1.10",
      "sharp": "0.35.5"
    },
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "tar": "7.5.22",
    "uuid": "14.0.2"
  }
}
