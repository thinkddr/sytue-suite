# ===========================================================================
# Sytue One — variables del entorno DEV (Docker Compose)
# Copia a `.env` y rellena con valores LOCALES de desarrollo.
#   cp .env.example .env
#
# IMPORTANTE: estos son PLACEHOLDERS solo-dev. NUNCA pongas secretos reales de
# producción aquí ni subas `.env` a git. En prod los secretos viven en Scaleway
# Secret Manager + Sealed Secrets.
#
# Stack: Go + Astro/Preact + PostgreSQL (estado/colas/caché). Blobs en S3 (MinIO
# en dev). SIN Redis/Valkey. SIN motores AGPL. Ver docs/CONVENTIONS.md.
# ===========================================================================

# --- Perfiles de Compose (DEV-ONLY) — qué apps se levantan ------------------
# `full` = suite COMPLETA clásica (idéntica a antes; ahora con límites de memoria
# para caber en un local de 8 GB). `make dev-up`/`dev-down` leen ESTE valor.
# Para trabajar en UNA app y ahorrar RAM, arranca solo su(s) perfil(es):
#     COMPOSE_PROFILES=docs make dev-up        # núcleo + docs
#     make dev-app P=docs,mail                 # atajo equivalente (núcleo + docs + mail)
# Núcleo (traefik, postgres, minio, dragonfly, id, hub) SIEMPRE arriba (sin perfil).
# Perfiles por app: mail drive docs calendar contacts rooms cloud portal console www.
COMPOSE_PROFILES=

# --- PostgreSQL 16 (único datastore; superusuario) --------------------------
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# --- Una BD/rol por servicio Go (services/<svc>) ----------------------------
ID_DB_NAME=
ID_DB_USER=
ID_DB_PASSWORD=

DRIVE_DB_NAME=
DRIVE_DB_USER=
DRIVE_DB_PASSWORD=

DOCS_DB_NAME=
DOCS_DB_USER=
DOCS_DB_PASSWORD=

MAIL_DB_NAME=
MAIL_DB_USER=
MAIL_DB_PASSWORD=

CALENDAR_DB_NAME=
CALENDAR_DB_USER=
CALENDAR_DB_PASSWORD=

CONTACTS_DB_NAME=
CONTACTS_DB_USER=
# SyERP (:8098). El ROL de Postgres se crea con esta contraseña en el arranque
# del contenedor de base de datos (deploy/compose/postgres/init/01-databases.sh),
# y solo ahí: si falta, el rol nace SIN contraseña y el servicio se queda
# reiniciando con «password authentication failed» — un fallo que no menciona
# esta variable por ningún lado.
SYERP_DB_NAME=
SYERP_DB_USER=
SYERP_DB_PASSWORD=
# Notepads y Sytue Photos: el mismo init crea sus roles con estas contraseñas, y
# faltaban de esta plantilla; con la variable vacía, el rol nacía sin
# contraseña y el servicio se quedaba reiniciando, igual que le pasó a SyERP.
NOTES_DB_NAME=
NOTES_DB_USER=
NOTES_DB_PASSWORD=
SYPHOTOS_DB_NAME=
SYPHOTOS_DB_USER=
SYPHOTOS_DB_PASSWORD=
# Sytue Cast (vídeo bajo demanda y directo, :8099): base propia como los demás.
CAST_DB_NAME=
CAST_DB_USER=
CAST_DB_PASSWORD=
# Los secretos propios de Cast caen al valor de desarrollo del código si van
# vacíos (services/cast/internal/config): solo hace falta ponerlos para cambiarlos.
# CAST_MEDIA_SIGNING_KEY=
# CAST_INTERNAL_SECRET=
# Sytue Web (webs y tiendas de la organización, :8100): base propia como los demás.
PAGES_DB_NAME=
PAGES_DB_USER=
PAGES_DB_PASSWORD=
# Sytue Bases (tablas relacionales, :8102).
BASES_DB_NAME=
BASES_DB_USER=
BASES_DB_PASSWORD=
# Sella el secreto de firma de los webhooks de Stripe (AES-256 en base64).
# Vacía es legítimo en dev: entonces no se puede configurar ningún webhook y el
# servicio lo dice al arrancar, en vez de guardar el secreto en claro.
SYERP_SECRET_ENC_KEY=

ROOMS_DB_NAME=
ROOMS_DB_USER=
ROOMS_DB_PASSWORD=
CONTACTS_DB_PASSWORD=



HUB_DB_NAME=
HUB_DB_USER=
HUB_DB_PASSWORD=

# BD de Sytue Integration Gateway (pasarela de interoperabilidad con SaaS)
INTEGRATIONS_DB_NAME=
INTEGRATIONS_DB_USER=
INTEGRATIONS_DB_PASSWORD=
# KEK para sellar secretos de instancia at-rest (base64 de 32 bytes AES-256).
# Opcional en dev: sin ella el gateway arranca pero rechaza escribir secretos (503, nunca en claro).
INTEGRATIONS_KEY_ENCRYPTION_KEY=

# BD de Sytue Cloud (PaaS / DB Studio sobre PostgREST)
CLOUD_DB_NAME=
CLOUD_DB_USER=
CLOUD_DB_PASSWORD=
# Sytue Analytics: base propia (analitica web anonima, ADR 0026).
ANALYTICS_DB_PASSWORD=
# KEK AES-256 en base64 con la que se cifra la SAL DIARIA en reposo. VACIA = la
# sal se guarda en claro y un volcado de PostgreSQL basta para recalcular los
# hashes del dia, que es justo lo que el cifrado impide. Generar con:
#   openssl rand -base64 32
SYTUE_ANALYTICS_KEY_ENCRYPTION_KEY=

# --- MinIO (Object Storage S3 dev) ------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- LiveKit server (Sytue Meet — SFU WebRTC, Apache-2.0) -------------------
# Par api_key/api_secret de LiveKit. El BFF de Meet (servicio Go) firma con
# ellos los JWT de acceso a la sala TRAS validar la sesión OIDC contra Sytue ID.
# Si cambias esta clave, cambia también `webhook.api_key` en
# deploy/compose/livekit/livekit.yaml: ese fichero se monta como volumen y no interpola
# variables, así que un valor distinto dejaría al SFU firmando avisos que Meet rechaza.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- PostgREST (API REST de Sytue Cloud DB Studio en dev) -------------------
POSTGREST_ROLE=
POSTGREST_ROLE_PASSWORD=
# Secreto JWT que PostgREST usa para validar tokens (compartido con cloud-api).
POSTGREST_JWT_SECRET=

# --- Sytue Cloud: clave de cifrado de secretos (AES-256, base64 de 32 bytes) --
# Usada por cloud-api y cloud-builder (SECRET_ENC_KEY) para sellar credenciales.
# Genera una propia con: openssl rand -base64 32
CLOUD_SECRET_ENC_KEY=

# --- Sytue Docs: clave de cifrado del conector de datos externos (Power Query) --
# AES-256 (base64 de 32 bytes). Cifra at-rest las credenciales de las conexiones
# (REST api-key/bearer/basic/OAuth2 y contraseña PostgreSQL). Sin ella el conector
# rechaza las conexiones con credenciales. Genera una propia con: openssl rand -base64 32
DOCS_SECRET_ENC_KEY=

# --- Sytue Rooms: secreto de los endpoints internos de chat -----------------
# Autentica las llamadas service-to-service a Sytue Chat: el aviso meet→chat
# («llamada finalizada») y la VERJA que consulta Drive para servir un adjunto solo a
# los miembros del canal. El MISMO valor en chat, drive y meet. Sin él, los adjuntos
# con ámbito de canal no se sirven a nadie (fail-closed). Genera uno con:
# openssl rand -hex 32
ROOMS_INTERNAL_SECRET=
# Compartido por Sytue ID y Sytue Mail: verifica las contraseñas de aplicación
# con las que entra un cliente de correo (Thunderbird, Outlook, el móvil).
ID_INTERNAL_SECRET=

# --- OIDC / BFF de las apps frontend (@sytue/auth) --------------------------
# Cookie de sesión de la suite (sellado HS256/A256GCM). >= 32 caracteres.
# Genera una propia con: openssl rand -hex 32
SYTUE_SESSION_SECRET=
# Secreto compartido de los clients confidenciales OIDC en DEV. El mismo valor
# lo usan TODOS los BFF (SYTUE_OIDC_CLIENT_SECRET) y el seed de `id` lo fija
# como secret_hash de cada client confidencial. NUNCA un secreto real.
SYTUE_DEV_CLIENT_SECRET=

# --- Sytue AI (asistente del editor) ----------------------------------------
# Proveedor LLM del servicio `ai` (services/ai). La API key vive SOLO en el
# servidor (nunca llega al navegador ni a los logs). SIN AI_API_KEY el servicio
# arranca sano pero /assist responde 503 (el panel muestra «no configurado»).
#   - scaleway (por defecto): Generative APIs en la UE; pon tu clave real.
#   - openai-compat: modelo soberano/autohospedado; fija AI_BASE_URL + AI_MODEL.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
