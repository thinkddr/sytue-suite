# Sytue One dev (compose) — artefactos locales, NUNCA versionar
.env
.env.*
!.env.example

# Certificados TLS locales (mkcert)
traefik/certs/*.pem
# ./sytue-deploy --mode servidor: compose renderizado para tu dominio, alias y
# configuración de Let's Encrypt (se regeneran en cada ejecución).
.servidor/

# Complemento Matrix: homeserver.yaml con sus secretos (lo genera ./sytue-deploy).
.matrix/
