#
# Traefik: los Secrets salen del ClusterRole y bajan a un Role por namespace.
#
# trivy marcaba KSV-0041 (CRITICAL) en el ClusterRole que trae el chart: leer
# Secrets a nivel de CLÚSTER equivale en la práctica a cluster-admin, porque ahí
# viven los tokens de cuentas de servicio con más permisos que el propio Traefik.
#
# Traefik solo necesita los Secrets de los certificados TLS y de los middlewares
# de los Ingress que vigila, y esos están en los mismos namespaces que ellos. El
# permiso pasa a emitirse como Role + RoleBinding por namespace vigilado,
# reutilizando la lista que el propio chart ya calcula para `rbac.namespaced`.
#
# HAY QUE DECLARAR LOS NAMESPACES VIGILADOS en `providers.kubernetesCRD.namespaces`
# y `kubernetesIngress.namespaces`. NO es opcional ni cosmético: con esas listas
# VACÍAS, Traefik vigila a nivel de clúster, su informer de Secrets muere con
# «secrets is forbidden ... at the cluster scope», NUNCA completa la sincronización
# inicial y responde 404 a TODOS los hosts. Y no falla al desplegar: falla en el
# primer reinicio del pod, porque hasta entonces sirve de su tabla en memoria.
# Comprobado el 2026-09-05, con la suite entera caída.
#
# Se aplica en scripts/prepare-helm-vendor.sh, sobre el .tgz oficial verificado.
--- a/templates/rbac/clusterrole.yaml
+++ b/templates/rbac/clusterrole.yaml
@@ -34,20 +34,26 @@
       - pods
     verbs:
       - get
-  - apiGroups:
-      - ""
-    resources:
-      - secrets
-    verbs:
-      - get
-      - list
-      - watch
-    {{- if and .Values.hub.token }}
-      - update
-      - create
-      - delete
-      - deletecollection
-    {{- end }}
+  {{/*
+    SYTUE: los `secrets` NO van en el ClusterRole.
+
+    Leer secretos a nivel de CLÚSTER equivale en la práctica a cluster-admin —de
+    ahí el KSV-0041 (CRITICAL) que trivy señalaba en este mismo fichero—: en el
+    clúster hay tokens de cuentas de servicio con permisos mayores, y quien lee
+    todos los Secrets los lee también.
+
+    Traefik solo necesita los Secrets de los certificados TLS y de los
+    middlewares de los Ingress que vigila, que están en los MISMOS namespaces
+    que esos Ingress. Ese permiso se emite ahora como Role + RoleBinding por
+    namespace vigilado, en `role-secrets.yaml`, y la lista de namespaces sale de
+    la misma maquinaria del chart (`providers.*.namespaces`, más el del release).
+
+    TODO NAMESPACE CON INGRESS VA EN `providers.kubernetesCRD.namespaces` y
+    `kubernetesIngress.namespaces`. Con esas listas vacías Traefik vigila a nivel
+    de clúster, su informer de Secrets muere con «forbidden ... at the cluster
+    scope», no completa la sincronización inicial y devuelve 404 a TODOS los
+    hosts, en el primer reinicio del pod. Comprobado el 2026-09-05.
+  */}}
   {{- if or .Values.providers.kubernetesIngress.enabled .Values.providers.kubernetesIngressNGINX.enabled }}
   - apiGroups:
       - extensions
--- a/templates/rbac/role-secrets.yaml
+++ b/templates/rbac/role-secrets.yaml
@@ -0,0 +1,62 @@
+{{/*
+  SYTUE: el permiso de leer Secrets, acotado a los namespaces vigilados.
+
+  Sustituye al bloque de `secrets` que este chart ponía en el ClusterRole y que
+  trivy marcaba como KSV-0041 (CRITICAL): a nivel de clúster, leer Secrets es
+  leer también los tokens de cuentas de servicio con más permisos que Traefik.
+
+  La lista de namespaces es la MISMA que usan `role.yaml` y `rolebinding.yaml`
+  cuando `rbac.namespaced` está activo, para que no haya dos criterios: el
+  namespace del release más los que declare cada provider. Con `rbac.namespaced`
+  no se emite nada aquí, porque entonces ese Role ya incluye los Secrets.
+*/}}
+{{- $ingressNamespaces := concat (include "traefik.namespace" . | list) .Values.providers.kubernetesIngress.namespaces -}}
+{{- $CRDNamespaces := concat (include "traefik.namespace" . | list) .Values.providers.kubernetesCRD.namespaces -}}
+{{- $knativeNamespaces := concat (include "traefik.namespace" . | list) ((.Values.providers.knative).namespaces) -}}
+{{- $hubNamespaces := concat (include "traefik.namespace" . | list) .Values.hub.namespaces -}}
+{{- $ingressNGINXNamespaces := ternary (splitList "," (include "providers.kubernetesIngressNGINX.namespaces" .)) (list) .Values.providers.kubernetesIngressNGINX.enabled -}}
+{{- $allNamespaces := sortAlpha (uniq (concat $ingressNamespaces $CRDNamespaces $hubNamespaces $knativeNamespaces $ingressNGINXNamespaces)) -}}
+
+{{- if and .Values.rbac.enabled (not .Values.rbac.namespaced) -}}
+{{- range $allNamespaces }}
+---
+kind: Role
+apiVersion: rbac.authorization.k8s.io/v1
+metadata:
+  name: {{ printf "%s-secrets" (include "traefik.fullname" $) }}
+  namespace: {{ . }}
+  labels:
+    {{- include "traefik.labels" $ | nindent 4 }}
+rules:
+  - apiGroups:
+      - ""
+    resources:
+      - secrets
+    verbs:
+      - get
+      - list
+      - watch
+    {{- if and $.Values.hub.token }}
+      - update
+      - create
+      - delete
+      - deletecollection
+    {{- end }}
+---
+kind: RoleBinding
+apiVersion: rbac.authorization.k8s.io/v1
+metadata:
+  name: {{ printf "%s-secrets" (include "traefik.fullname" $) }}
+  namespace: {{ . }}
+  labels:
+    {{- include "traefik.labels" $ | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: {{ printf "%s-secrets" (include "traefik.fullname" $) }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ include "traefik.serviceAccountName" $ }}
+    namespace: {{ include "traefik.namespace" $ }}
+{{- end }}
+{{- end }}
