# Fuente oficial de ImageMagick: asset y digest de la release estable 7.1.2-34.
# Debian 12 instala ImageMagick 6 (convert), sin el comando magick del empaquetado.
IMAGEMAGICK_VERSION=7.1.2-34
IMAGEMAGICK_SOURCE_SHA256=55fe0ec246245b46c429f9e6bc65294ad4a78a66b88abd9817971ca157856323
COSIGN_VERSION=3.1.4
COSIGN_LINUX_AMD64_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
COSIGN_LINUX_ARM64_SHA256=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
# macOS porque los clientes de escritorio se firman fuera de Sytue Git (ver
# codemagic.yaml) y esa VM no trae cosign: el build de v2.13.19 compiló los tres
# bundles y murió al publicar con «cosign: command not found». Del fichero de
# checksums oficial de la misma release; el de linux-amd64 de arriba coincide con
# él, que es lo que confirma que la fuente es la buena.
COSIGN_DARWIN_ARM64_SHA256=9f9b8cd557cf2e5b3df3373a00baa005a86b02391e3e06dd0ce37b3a1533d3a4
COSIGN_DARWIN_AMD64_SHA256=9d1e4abe2b6be279ed0d2ff706fde1ccd738747c834e3e6d44039c238867334f
SYFT_VERSION=1.55.0
SYFT_LINUX_AMD64_SHA256=bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d
SYFT_LINUX_ARM64_SHA256=929bd163db2d7cd2255d3bcb8967208079813d7b46b0c952f7b794d8e2c7d304
# Trivy se ejecuta en los dos tipos de runner que etiqueta `docker`: el
# tarball de amd64 se llama históricamente `64bit`, mientras que el de ARM64
# usa `ARM64`. No se pueden intercambiar aunque ambos se descompriman como
# `trivy`: el kernel solo lo revela tarde con «Exec format error».
TRIVY_VERSION=0.76.1
TRIVY_LINUX_AMD64_SHA256=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0
TRIVY_LINUX_ARM64_SHA256=e174dff2a6dba5e3ae41f8d0537a6324405bd08132497340304c6b20e0f16a1f
# osv-scanner lo usan DOS jobs de security —el escáner de dependencias y el del
# SBOM— y su versión vivía solo dentro del Containerfile del runner y repetida a
# mano dentro de un `run:` del workflow. El del SBOM lo llamaba a pelo, dando por
# hecho que la imagen lo trae, y en el runner compartido de git.gay no está: el
# job moría con «osv-scanner: command not found» después de generar el SBOM.
OSV_SCANNER_VERSION=2.7.0
OSV_SCANNER_SHA256=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
OSV_SCANNER_LINUX_AMD64_SHA256=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
OSV_SCANNER_LINUX_ARM64_SHA256=4061ef4c021ed3c47f203b818f337e351336cc5cd67c0274fc36bd1dfc728dd7
GOLANGCI_LINT_VERSION=2.15.0
GOVULNCHECK_VERSION=1.9.0
GO_LICENSES_VERSION=2.0.1
# `fyne package` empaqueta apps/fyne para los cinco destinos. La CLI (módulo
# fyne.io/tools, distinto de la biblioteca) iba con `@latest`, y así el mismo tag
# empaquetaba con una herramienta distinta según el día (diagnóstico del CI del
# 2026-09-23). Se fija aquí, como golangci-lint; la biblioteca que compila el
# producto sigue en apps/fyne/go.mod. Ojo al subirla:
# v1.26.x está retractada, el `@latest` del proxy es la última v1.7.
FYNE_TOOLS_VERSION=1.7.4
# iOS va por el camino oficial desde el 2026-11-06: la 1.7.4 prohíbe `fyne build` para
# iOS, así que el paquete de TestFlight sale entero de `fyne package --target ios`, y el
# Simulador y la fase de Xcode compilan con `go build` y los metadatos de
# apps/fyne/herramientas/metadatos. Ver «iOS por el camino oficial» en docs/operations.md.
# bundletool arma el AAB de Android a partir del APK de Fyne y lee su manifiesto para
# verificarlo (apps/fyne/scripts/empaquetar.sh, release-mobile.yml). Es un .jar: el
# mismo fichero en Linux y en macOS. SHA-256 del asset de la release de google/bundletool.
BUNDLETOOL_VERSION=1.18.3
BUNDLETOOL_SHA256=a099cfa1543f55593bc2ed16a70a7c67fe54b1747bb7301f37fdfd6d91028e29

# El SDK de Android con el que release-mobile.yml compila los AAB en nuestros runners
# (ARM64): las cmdline-tools fijadas por sha256 y, con su sdkmanager —que verifica cada
# paquete contra el repositorio de Google—, el NDK, la plataforma y las build-tools.
# Google no publica NDK para Linux ARM64: sus binarios x86_64 corren por qemu-user
# (binfmt del frontal). Es el NDK que usaba Codemagic. Ver «Android sin Codemagic».
ANDROID_CMDLINE_TOOLS_VERSION=13114758
ANDROID_CMDLINE_TOOLS_SHA256=7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee
# Las mismas cmdline-tools para macOS: el Android Emulator de android-emulador.yml corre en
# el Mac del runner (sytue-macos), porque Google no lo publica para Linux ARM64.
ANDROID_CMDLINE_TOOLS_MAC_SHA256=5673201e6f3869f418eeed3b5cb6c4be7401502bd0aae1b12a29d164d647a54e
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_BUILD_TOOLS_VERSION=36.0.0

# jsign firma los .exe de Windows contra Azure Artifact Signing (release-desktop.yml, ver
# «Windows: Azure Artifact Signing» en docs/operations.md). Es un .jar: el mismo fichero en
# cualquier runner. SHA-256 del asset jsign-<versión>.jar de la release de ebourg/jsign.
JSIGN_VERSION=7.6
JSIGN_SHA256=6cf58aa080e7ff82656f320cff8d4a3bff30408df8766806dcba3740dd839fa5
# El gate de scripts de producción reconstruye dependencias de charts.
# crane lo usa el espejo del catálogo (mirror-catalog.yml) para copiar imágenes
# entre registros sin docker. Estaba SOLO como ARG del Containerfile del runner,
# así que cuando el CI pasó a un runner que no trae esa imagen no había de dónde
# sacar la versión: el workflow abortaba pidiendo reconstruir un runner retirado.
CRANE_VERSION=0.22.1
# BuildKit del CI (ADR 0066): el mismo tarball da el `buildkitd` sin root que corre en
# el frontal (deploy/rooms-sfu/instalar-docker-ci.sh buildkit) y el `buildctl` con
# el que los jobs le hablan (accion.sh buildctl). Una sola versión para los dos:
# cliente y demonio de versiones distintas se entienden, pero no se prueba así.
BUILDKIT_VERSION=0.33.0
BUILDKIT_LINUX_AMD64_SHA256=b6242896d343100808dcbe37565caf381e0a444a6a83d7255926bb1519248ead
BUILDKIT_LINUX_ARM64_SHA256=e5acfb5929f967fde3b925ddb39f79fd481a0e96774c641fab3a0e83950d7bfa
HELM_VERSION=v4.3.1
HELM_SHA256=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
HELM_LINUX_AMD64_SHA256=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
HELM_LINUX_ARM64_SHA256=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88

# Las acciones de GitHub que usan los workflows, FIJADAS por SHA de commit: una
# etiqueta `@v7` se mueve sola y cambiaría lo que ejecuta el CI sin que cambie el
# repositorio. `scripts/check-toolchain-versions.sh` exige que cada `uses:` de
# `.github/workflows` lleve exactamente estos. Para subirlas: el SHA del tag en
# el repositorio de la acción (`git ls-remote --tags`), aquí y en los workflows.
ACTION_CHECKOUT_SHA=3d3c42e5aac5ba805825da76410c181273ba90b1
ACTION_CHECKOUT_VERSION=v7.0.1
ACTION_UPLOAD_ARTIFACT_SHA=cf430e030ddbb5b0abf93d22962f4752f3646cd9
ACTION_UPLOAD_ARTIFACT_VERSION=v7.0.2
ACTION_CACHE_SHA=55cc8345863c7cc4c66a329aec7e433d2d1c52a9
ACTION_CACHE_VERSION=v6.1.0
