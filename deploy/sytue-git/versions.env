# Versiones y hashes autoritativos de Sytue Git (Gitea).
# SYTUE_GIT_SHA256 es el del binario suelto (dl.gitea.com publica su .sha256);
# SYTUE_GIT_RUNNER_SHA256, el del .xz, que es lo único que Gitea firma del runner.
SYTUE_GIT_VERSION=1.27.2
SYTUE_GIT_SHA256=aa4e624ca6aa58a824a75562caecc2d206fcab8c70bc8fab765b456f182844fd
SYTUE_GIT_RUNNER_VERSION=3.0.2
SYTUE_GIT_RUNNER_SHA256=000894ca3b26fa6bb73960c84f558b46d0a2d4e1a07255d14879a9749a54f657
# El runner de macOS es el MISMO programa, compilado para Apple Silicon: corre en
# modo host (sin contenedor) porque compilar y firmar una app de macOS necesita el
# Xcode y el llavero de la propia máquina.
SYTUE_GIT_RUNNER_DARWIN_ARM64_SHA256=410e6180370a431320702730d0d4cec594f9cb5b6c307137ba90bb1d9351d815

# El proxy inverso que reparte el 443 de la máquina entre la forja y la pasarela
# GHES es Caddy, y NO se instala desde aquí: ya estaba en la máquina y se le
# añadió el segundo nombre (deploy/sytue-git/caddy/Caddyfile). Es de ZeroSSL
# GmbH, Viena, y desde el 2026-08-16 está en el inventario de cadena de
# suministro; antes se creyó lo contrario y por eso se llegó a preparar un
# Traefik que nunca corrió.
#
# La versión la manda el paquete de Debian de la máquina; esto es lo OBSERVADO
# allí el 2026-08-16, no lo que instala nadie desde aquí. Si algún día se pasa a
# instalarlo desde el repo, este es el sitio de su hash.
CADDY_VERSION_OBSERVADA=v2.11.4

DEBIAN_IMAGE_ID=72d2b985-dc02-4333-af0b-3e91d5fcbc3d
DEBIAN_IMAGE_DATE=2026-07-15
DEBIAN_CONTAINER=debian:13.1-slim
DEBIAN_CONTAINER_DIGEST=sha256:a347fd7510ee31a84387619a492ad6c8eb0af2f2682b916ff3e643eb076f925a

GO_VERSION=1.27.4
GO_LINUX_AMD64_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
GO_LINUX_ARM64_SHA256=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92
# Los clientes de macOS se construyen fuera de Sytue Git —ver codemagic.yaml— y
# allí Go NO viene en la imagen. Se instala con la MISMA versión de arriba y su
# sha256 verificado, igual que en Linux: que el build salga de otro proveedor no
# es motivo para bajar el listón de lo que se ejecuta.
# Las dos arquitecturas porque el mismo `accion.sh` sirve para el Mac de un
# desarrollador (Intel o Apple Silicon) y para el runner de Codemagic (M2).
GO_DARWIN_ARM64_SHA256=91a44a2b8a716600ad94a4f143e156116620db8828086a6e3602291be9bd0bb4
GO_DARWIN_AMD64_SHA256=2b799377704ef12db39bd254995d5c348c9cc8d86562ca817724390e56c38f43
NODE_VERSION=26.12.1
NODE_LINUX_X64_SHA256=6170b2d474e1c626f43cff3adc118df9fe3b573258a4fc3d850c8dbc6b079bbd
BUN_VERSION=1.4.4
# La imagen propia sigue usando el nombre histórico `X64`; la acción compartida
# usa la forma uniforme `AMD64`/`ARM64` para elegir el artefacto del runner.
BUN_LINUX_X64_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
BUN_LINUX_AMD64_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
BUN_LINUX_ARM64_SHA256=baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e
BUN_DARWIN_ARM64_SHA256=c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510
BUN_DARWIN_AMD64_SHA256=50a3491f73abc2fe81673171a85762d3bc2cc1680ccecadd983de99adf77977e
# Binarios oficiales de jqlang/jq, release jq-1.8.2; hashes de sus assets y sha256sum.txt.
# Misma versión en Linux y macOS: el jq del sistema no satisface el pin del CI.
JQ_VERSION=1.8.2
JQ_LINUX_AMD64_SHA256=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
