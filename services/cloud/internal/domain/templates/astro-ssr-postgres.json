{
  "id": "astro-ssr-postgres",
  "name": "Full-stack Astro SSR + Postgres",
  "description": "Astro con render en servidor y una base Sytue Postgres aprovisionada.",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "maintainer": "Sytue",
  "framework": "astro",
  "build": {
    "strategy": "buildpacks",
    "install": "bun install --frozen-lockfile",
    "build": "bun run build"
  },
  "services": ["postgres"],
  "env": [
    {
      "key": "DATABASE_URL",
      "origin": "from_service",
      "service": "postgres"
    }
  ],
  "docs_url": "https://docs.astro.build/en/guides/on-demand-rendering/",
  "tags": ["ssr", "fullstack"]
}
