 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1">
   <style:header><text:p text:style-name="Header">Cooperativa La Vega, uso interno</text:p></style:header>
   <style:footer><text:p text:style-name="Footer">Pie del informe trimestral</text:p></style:footer>
  </style:master-page>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:tracked-changes>
    <text:changed-region text:id="ct1">
     <text:insertion><office:change-info><dc:creator>Lucía Prieto</dc:creator><dc:date>2026-09-30T10:00:00</dc:date></office:change-info></text:insertion>
    </text:changed-region>
    <text:changed-region text:id="ct2">
     <text:deletion><office:change-info><dc:creator>Lucía Prieto</dc:creator><dc:date>2026-09-30T10:05:00</dc:date></office:change-info><text:p>texto retirado</text:p></text:deletion>
    </text:changed-region>
   </text:tracked-changes>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Informe trimestral de la cooperativa</text:h>
   <text:p text:style-name="Standard">Este trimestre hubo una <text:span text:style-name="T1">cosecha récord</text:span>, leída <text:span text:style-name="T2">con matices</text:span>, con un dato <text:span text:style-name="T3">subrayado</text:span>, un <text:span text:style-name="T4">precio antiguo</text:span> y una cifra <text:span text:style-name="T5">en rojo</text:span>.</text:p>
   <text:p text:style-name="Standard">Consulte la <text:a xlink:type="simple" xlink:href="https://www.sytue.eu/cooperativa">web de la cooperativa</text:a> para el detalle.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Resultados del huerto</text:h>
   <text:p text:style-name="P1">Texto centrado del resumen</text:p>
   <text:p text:style-name="P2">Texto a la derecha del resumen</text:p>
   <text:p text:style-name="P3">Texto justificado del resumen, con la longitud suficiente para que el reparto de espacios se note en la línea.</text:p>
   <text:p text:style-name="Quotations">La tierra no se hereda, se toma prestada.</text:p>
   <text:list text:style-name="L1">
    <text:list-item><text:p>Tomates</text:p></text:list-item>
    <text:list-item><text:p>Pimientos</text:p></text:list-item>
   </text:list>
   <text:list text:style-name="L2">
    <text:list-item><text:p>Preparar la tierra</text:p>
     <text:list>
      <text:list-item><text:p>Abonar el bancal</text:p></text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item><text:p>Sembrar</text:p></text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_3" text:outline-level="3">Detalle por parcela</text:h>
   <table:table table:name="Parcelas">
    <table:table-column table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Parcela</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Kilos</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Norte</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p><office:annotation office:name="c1"><dc:creator>Marta Gil</dc:creator><dc:date>2026-09-29T09:00:00</dc:date><text:p>Revisar esta cifra con tesorería</text:p></office:annotation>1200<office:annotation-end office:name="c1"/></text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:number-rows-spanned="2" office:value-type="string"><text:p>Zona sur</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>900</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:covered-table-cell/>
     <table:table-cell office:value-type="string"><text:p>850</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:number-columns-spanned="2" office:value-type="string"><text:p>Total anual de las parcelas</text:p></table:table-cell>
     <table:covered-table-cell/>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard">La parcela norte en planta: <draw:frame draw:style-name="fr1" draw:name="Parcela" text:anchor-type="as-char" svg:width="2cm" svg:height="2cm" draw:z-index="0"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAHUlEQVR42mPQa1tNEmIY1UATDT1JliShUQ000QAAFExDEHL4q6wAAAAASUVORK5CYII=</office:binary-data></draw:image></draw:frame></text:p>
   <text:p text:style-name="Standard">El peso declarado<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>Datos de la báscula municipal.</text:p></text:note-body></text:note> cuadra con el registro<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p>Fuente: libro de registro de la cooperativa.</text:p></text:note-body></text:note>.</text:p>
   <text:p text:style-name="Standard">En la revisión se dejó un párrafo <text:change-start text:change-id="ct1"/>añadido en revisión<text:change-end text:change-id="ct1"/> y se quitó <text:change text:change-id="ct2"/>el resto.</text:p>
  </office:text>
 </office:body>
</office:document>
