{
  "version": 1,
  "rutas": [
    "^{L}/([a-z0-9-]+/)*index\\.html$",
    "^{L}/404\\.html$",
    "^sitemap\\.xml$",
    "^robots\\.txt$",
    "^_astro/[0-9a-f]{16}\\.css$"
  ],
  "tipos": {
    "css": "text/css; charset=utf-8",
    "html": "text/html; charset=utf-8",
    "jpg": "image/jpeg",
    "js": "text/javascript; charset=utf-8",
    "pdf": "application/pdf",
    "png": "image/png",
    "txt": "text/plain; charset=utf-8",
    "woff2": "font/woff2",
    "xml": "application/xml; charset=utf-8"
  },
  "limites": {
    "ficheros": 5000,
    "bytes_html": 2097152,
    "bytes_total": 67108864
  },
  "html": {
    "atributos_globales": ["class", "dir", "hidden", "id", "inert", "lang", "role", "tabindex", "title", "translate"],
    "prefijos_globales": ["aria-", "data-"],
    "elementos": {
      "a": ["download", "href", "hreflang", "rel", "target", "type"],
      "abbr": [],
      "address": [],
      "article": [],
      "aside": [],
      "blockquote": ["cite"],
      "body": [],
      "br": [],
      "button": ["disabled", "form", "name", "type", "value"],
      "caption": [],
      "dd": [],
      "del": [],
      "details": ["name", "open"],
      "div": [],
      "dl": [],
      "dt": [],
      "em": [],
      "fieldset": ["disabled", "name"],
      "figcaption": [],
      "figure": [],
      "footer": [],
      "form": ["action", "autocomplete", "method", "novalidate"],
      "h1": [],
      "h2": [],
      "h3": [],
      "h4": [],
      "h5": [],
      "h6": [],
      "head": [],
      "header": [],
      "hr": [],
      "html": [],
      "iframe": ["allow", "allowfullscreen", "height", "loading", "referrerpolicy", "sandbox", "src", "width"],
      "img": ["alt", "decoding", "fetchpriority", "height", "loading", "sizes", "src", "srcset", "width"],
      "input": ["autocomplete", "checked", "disabled", "form", "inputmode", "max", "maxlength", "min", "minlength", "name", "pattern", "placeholder", "readonly", "required", "step", "type", "value"],
      "ins": [],
      "label": ["for"],
      "legend": [],
      "li": ["value"],
      "link": ["as", "crossorigin", "href", "hreflang", "media", "rel", "sizes", "type"],
      "main": [],
      "mark": [],
      "meta": ["charset", "content", "name", "property"],
      "nav": [],
      "ol": ["reversed", "start"],
      "option": ["disabled", "selected", "value"],
      "output": ["for", "name"],
      "p": [],
      "picture": [],
      "s": [],
      "script": ["defer", "src", "type"],
      "section": [],
      "select": ["autocomplete", "disabled", "name", "required"],
      "small": [],
      "source": ["height", "media", "sizes", "srcset", "type", "width"],
      "span": [],
      "strong": [],
      "sub": [],
      "summary": [],
      "sup": [],
      "table": [],
      "tbody": [],
      "td": ["colspan", "rowspan"],
      "textarea": ["autocomplete", "disabled", "maxlength", "minlength", "name", "placeholder", "readonly", "required", "rows"],
      "tfoot": [],
      "th": ["colspan", "rowspan", "scope"],
      "thead": [],
      "time": ["datetime"],
      "title": [],
      "tr": [],
      "u": [],
      "ul": []
    },
    "valores": {
      "a.target": ["_blank"],
      "button.type": ["button", "reset", "submit"],
      "form.method": ["get", "post"],
      "iframe.loading": ["eager", "lazy"],
      "iframe.referrerpolicy": ["no-referrer", "strict-origin-when-cross-origin"],
      "img.loading": ["eager", "lazy"],
      "input.type": ["checkbox", "date", "email", "hidden", "number", "radio", "search", "submit", "tel", "text", "time"],
      "link.as": ["font", "image", "style"],
      "link.rel": ["alternate", "canonical", "icon", "preload", "stylesheet"]
    },
    "atributos_url": ["action", "cite", "href", "src"],
    "atributos_srcset": ["srcset"],
    "esquemas": ["https:", "mailto:", "tel:"],
    "form_action": "^/_pages/",
    "iframe_origenes": ["https://www.openstreetmap.org", "$PAGES_CAST_ORIGIN", "https://www.youtube-nocookie.com", "https://player.vimeo.com"],
    "scripts": [
      { "type": "module", "src": "^/_astro/islas-[0-9a-f]{16}\\.js$" },
      { "defer": true, "src": "^/_sytue/s\\.js$" },
      { "type": "application/ld+json", "en_linea": "json" }
    ]
  },
  "svg": {
    "atributos_comunes": ["aria-hidden", "aria-label", "class", "clip-rule", "fill", "fill-opacity", "fill-rule", "id", "opacity", "role", "stroke", "stroke-dasharray", "stroke-linecap", "stroke-linejoin", "stroke-miterlimit", "stroke-opacity", "stroke-width", "transform", "vector-effect"],
    "elementos": {
      "circle": ["cx", "cy", "r"],
      "desc": [],
      "g": [],
      "line": ["x1", "x2", "y1", "y2"],
      "path": ["d"],
      "polygon": ["points"],
      "polyline": ["points"],
      "rect": ["height", "rx", "ry", "width", "x", "y"],
      "svg": ["focusable", "height", "preserveaspectratio", "viewbox", "width", "xmlns"],
      "title": []
    }
  },
  "css": {
    "reglas_at": ["font-face", "keyframes", "media", "supports"],
    "url_prefijos": ["/_astro/"],
    "data_url_max_bytes": 2048,
    "prohibido": ["@import", "expression(", "javascript:", "behavior:", "-moz-binding"]
  },
  "vista_previa": {
    "franja": { "elemento": "div", "clase": "sp-vista", "role": "status" },
    "sin_elementos": ["form"]
  },
  "sitemap": {
    "elementos": ["url", "urlset", "loc", "lastmod", "xhtml:link"],
    "atributos": { "urlset": ["xmlns", "xmlns:xhtml"], "xhtml:link": ["href", "hreflang", "rel"] }
  },
  "robots": ["User-agent", "Allow", "Disallow", "Sitemap"]
}
