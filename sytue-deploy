    prompt_yes_no "¿Aplicar ahora los Secrets de integraciones y actualizar el despliegue?" "n"; then
    bash "$INTEG_APPLY"
    # shellcheck disable=SC2086 # helm_cmd se compone arriba con rutas sin espacios.
    (cd "$ROOT_DIR" && $helm_cmd)
    ok "Integraciones activadas. Entra en ${BOLD}https://admin.${DOMAIN}/admin/apps${RESET} y pulsa «Conectar»."
