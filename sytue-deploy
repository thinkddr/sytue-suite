generar_certificados() {
  if [ -s "${CERT_DIR}/sytue-localhost.pem" ] && [ -s "${CERT_DIR}/sytue-localhost-key.pem" ]; then
    ok "Certificado HTTPS local ya presente (deploy/compose/traefik/certs/)."
    return
  fi
  info "Instalando la autoridad local de mkcert (puede pedir tu contraseña de administrador una vez)..."
  mkcert -install
  mkdir -p "$CERT_DIR"
  mkcert -cert-file "${CERT_DIR}/sytue-localhost.pem" -key-file "${CERT_DIR}/sytue-localhost-key.pem" \
    "${LOCAL_DOMAIN}" "*.${LOCAL_DOMAIN}" >/dev/null 2>&1
  ok "Certificado HTTPS para *.${LOCAL_DOMAIN} creado."
}

# Espera a que todos los contenedores del perfil estén «healthy» (o «running» si
# no declaran healthcheck). Devuelve 1 si alguno sale o no lo consigue a tiempo.
esperar_salud() {
  local limite="${1:-900}" inicio ahora estado pendientes caidos
  inicio="$(date +%s)"
  while :; do
    estado="$(dc ps -a --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null || true)"
    # Los contenedores de una sola ejecución (minio-init) terminan con «exited».
    pendientes="$(printf '%s\n' "$estado" | awk 'NF && $1!="minio-init" && !($2=="running" && ($3=="" || $3=="healthy")) {print $1}' | sort -u | tr '\n' ' ')"
    caidos="$(printf '%s\n' "$estado" | awk 'NF && $1!="minio-init" && ($2=="exited" || $2=="dead" || $3=="unhealthy") {print $1}' | sort -u | tr '\n' ' ')"
    if [ -z "${pendientes// /}" ]; then
      return 0
    fi
    ahora="$(date +%s)"
    if [ $((ahora - inicio)) -ge "$limite" ]; then
      warn "Sin terminar de arrancar tras ${limite}s: ${pendientes}"
      [ -n "${caidos// /}" ] && warn "Con error: ${caidos} → mira sus logs con ${BOLD}make dev-logs SVC=<servicio>${RESET}"
      return 1
    fi
    printf "\r  ${DIM}Esperando a que arranquen: %-90.90s${RESET}" "$pendientes"
    sleep 5
  done
}

sembrar_admin() {
  local _
  for _ in 1 2 3 4 5 6; do
    if dc exec -T -e SYTUE_ID_DEV_SEED_PASSWORD="$(env_get SYTUE_ID_DEV_SEED_PASSWORD)" id /app/id seed >/dev/null 2>&1; then
      ok "Administrador listo en Sytue ID: ${BOLD}${LOCAL_ADMIN_EMAIL}${RESET} (organización ${LOCAL_ORG})."
      return 0
    fi
    sleep 5
  done
  return 1
}

