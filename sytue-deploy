    printf "    ${BOLD}3) https://admin.%s/admin/apps${RESET} → «Conectar» en cada aplicación\n" "$DOMAIN"
  fi
  exit 0
}

# ---------------------------------------------------------------------------
# Modo local: Docker Compose
# ---------------------------------------------------------------------------
dc() { docker compose --project-directory "$COMPOSE_DIR" -f "$COMPOSE_FILE" "$@"; }

# Valor de una variable del .env (sin interpretar el fichero como shell).
env_get() { [ -f "$ENV_FILE" ] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 || true; }

# Añade o sustituye una variable del .env.
env_set() {
  local clave="$1" valor="$2" tmp
  tmp="$(mktemp "${ENV_FILE}.XXXXXX")"
  grep -v "^${clave}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$clave" "$valor" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

# La api_key de LiveKit es un identificador público (el secreto es api_secret). Va
# fija en deploy/compose/livekit/livekit.yaml, que el SFU monta sin interpolar
# variables; el .env la toma de ahí para que webhook y tokens casen siempre.
livekit_api_key() {
  local k
  k="$(sed -n 's/^  api_key:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "${COMPOSE_DIR}/livekit/livekit.yaml" | head -1)"
  printf '%s' "${k:-changeme-livekit-api-key}"
}

perfiles_compose() {
  case "$1" in
    full)   echo "full" ;;
    office) echo "drive,docs,mail,calendar,contacts,portal,console" ;;
    core)   echo "portal,console" ;;
    *)      echo "$1" ;;
  esac
}

datos_locales_existen() {
  [ -n "$(docker volume ls -q --filter label=com.docker.compose.project=sytue-one-dev 2>/dev/null)" ]
}

puerto_ocupado_por_otro() { # puerto → 0 si algo que no es nuestro Traefik escucha
  local p="$1"
  (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null || return 1
  [ -z "$(docker ps -q --filter name=sytue-one-dev-traefik 2>/dev/null)" ]
}

requisitos_compose() {
  local fallos=0
  if ! check_cmd docker; then
    err "Falta Docker. Instala Docker Desktop (macOS/Windows) o Docker Engine (Linux): https://docs.docker.com/get-docker/"
    fallos=1
  elif ! docker info >/dev/null 2>&1; then
    err "Docker está instalado pero no responde. Arráncalo (Docker Desktop, o «colima start», o «sudo systemctl start docker») y vuelve a ejecutar."
    fallos=1
  elif ! docker compose version >/dev/null 2>&1; then
    err "Falta Docker Compose v2 (el subcomando «docker compose»). Actualiza Docker."
    fallos=1
  else
    ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null) y $(docker compose version --short 2>/dev/null | sed 's/^/Compose /')"
    local mem
    mem="$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)"
    mem=$(( ${mem:-0} / 1024 / 1024 / 1024 ))
    if [ "$mem" -gt 0 ] && [ "$mem" -lt 7 ] && [ "$(perfiles_compose "$PROFILE")" = "full" ]; then
      warn "Docker tiene ${mem} GB de memoria. La suite completa necesita unos 8 GB: sube la memoria de Docker o usa ${BOLD}--profile office${RESET}."
    else
      ok "Memoria disponible para Docker: ${mem} GB"
    fi
    # Disco: la primera construcción completa llega a ~25 GB entre imágenes y caché.
    # Solo se mide donde el directorio de Docker es visible (Linux); en Docker
    # Desktop vive dentro de su máquina virtual.
    local raiz libre
    raiz="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
    if [ -n "$raiz" ] && [ -d "$raiz" ]; then
      libre=$(( $(df -Pk "$raiz" | awk 'NR==2 {print $4}') / 1024 / 1024 ))
      if [ "$libre" -lt 25 ]; then
        warn "Quedan ${libre} GB libres en ${raiz}; la primera construcción necesita unos 25 GB (libera con «docker system prune»)."
      else
        ok "Disco libre para Docker: ${libre} GB"
      fi
    fi
  fi
  if check_cmd mkcert; then
    ok "mkcert $(mkcert -version 2>/dev/null)"
  else
    err "Falta mkcert (certificados HTTPS locales de confianza). Instálalo:"
    printf "      macOS:   brew install mkcert nss\n"
    printf "      Debian/Ubuntu: sudo apt install mkcert libnss3-tools\n"
    printf "      Windows: choco install mkcert   ·   Otros: https://github.com/FiloSottile/mkcert#installation\n"
    fallos=1
  fi
  local p
  for p in 80 443; do
    if puerto_ocupado_por_otro "$p"; then
      warn "El puerto ${p} de 127.0.0.1 ya está en uso por otro programa; la suite lo necesita para https://*.${LOCAL_DOMAIN}."
    fi
  done
  [ "$fallos" -eq 0 ] || die "Resuelve lo anterior y vuelve a ejecutar ${BOLD}./sytue-deploy${RESET}."
}

