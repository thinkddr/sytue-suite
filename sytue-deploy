instalar_compose() {
  # --- Paso 2: requisitos -----------------------------------------------------
  step "Paso 2 de 5 · Requisitos"
  if [ "$ONLY_CONFIG" -eq 1 ]; then
    check_cmd openssl || die "Falta openssl."
    ok "Solo configuración: no se comprueba Docker."
  else
    requisitos_compose
  fi

  # --- Paso 3: servicios ------------------------------------------------------
  step "Paso 3 de 5 · Servicios"
  local perfil_previo=""
  perfil_previo="$(env_get COMPOSE_PROFILES)"
  if [ -z "$PROFILE" ]; then
    if [ -n "$perfil_previo" ] && [ "$DO_RESET" -eq 0 ]; then
      PROFILE="$perfil_previo"
    elif [ "$NON_INTERACTIVE" -eq 1 ]; then
      PROFILE="full"
    else
      echo "  ¿Qué quieres levantar? (siempre se incluyen Sytue ID, Hub, PostgreSQL, S3 y Traefik)"
      echo "    1) Suite completa      — todas las aplicaciones (≈8 GB de RAM para Docker)"
      echo "    2) Ofimática           — Drive, Docus/Calcus/Diapos/CertiPDF, Mail, Calendar, Contacts"
      echo "    3) Mínimo              — solo identidad, portal y consola de administración"
      echo "    4) A medida            — perfiles separados por comas (p. ej. mail,drive,docs,rooms)"
      local opcion=""
      prompt_default "Opción" "1" opcion
      case "$opcion" in
        2) PROFILE="office" ;;
        3) PROFILE="core" ;;
        4) prompt_default "Perfiles" "mail,drive,docs,portal,console" PROFILE ;;
        *) PROFILE="full" ;;
      esac
    fi
  fi
  local perfiles
  perfiles="$(perfiles_compose "$PROFILE")"
  ok "Perfiles: ${BOLD}${perfiles}${RESET} · dominio local: ${BOLD}*.${LOCAL_DOMAIN}${RESET}"

  # --- Paso 4: configuración y secretos --------------------------------------
  step "Paso 4 de 5 · Configuración y secretos"
  if [ "$DO_RESET" -eq 1 ]; then
    if [ "$NON_INTERACTIVE" -eq 0 ] && ! prompt_yes_no "Se BORRARÁN todos los datos locales de la suite (bases de datos, ficheros, correo). ¿Continuar?" "n"; then
      die "Cancelado: no se ha borrado nada."
    fi
    if check_cmd docker && docker info >/dev/null 2>&1 && [ -f "$ENV_FILE" ]; then
      info "Parando la suite y borrando sus volúmenes..."
      dc --profile full down -v --remove-orphans >/dev/null 2>&1 || true
    fi
    [ -f "$ENV_FILE" ] && mv "$ENV_FILE" "${ENV_FILE}.bak" && chmod 600 "${ENV_FILE}.bak" && info "Configuración anterior guardada en deploy/compose/.env.bak"
  fi

  if [ -f "$ENV_FILE" ]; then
    ok "Se reutiliza ${BOLD}deploy/compose/.env${RESET} (sus contraseñas ya están en las bases de datos)."
    [ -z "$ADMIN_PASSWORD" ] && ADMIN_PASSWORD="$(env_get SYTUE_ID_DEV_SEED_PASSWORD)"
    if [ -z "$ADMIN_PASSWORD" ]; then resolver_password_admin; fi
    completar_env
    if [ "$PROFILE" != "$perfil_previo" ]; then env_set COMPOSE_PROFILES "$perfiles"; fi
    if [ "$(env_get SYTUE_ID_DEV_SEED_PASSWORD)" != "$ADMIN_PASSWORD" ]; then
      env_set SYTUE_ID_DEV_SEED_PASSWORD "$ADMIN_PASSWORD"
      ok "Contraseña del administrador actualizada."
    fi
  else
    if [ "$ONLY_CONFIG" -eq 0 ] && datos_locales_existen; then
      warn "Hay datos de una instalación anterior pero no su deploy/compose/.env: sus contraseñas ya no casarán."
      die "Recupera aquel .env, o empieza de cero con ${BOLD}./sytue-deploy --reset${RESET}."
    fi
    printf "  Cuenta de administración local: ${BOLD}%s${RESET} (organización %s)\n" "$LOCAL_ADMIN_EMAIL" "$LOCAL_ORG"
    resolver_password_admin
    if [ "$NON_INTERACTIVE" -eq 0 ] && prompt_yes_no "¿Configurar ahora un proveedor para Sytue AI? (opcional, se puede hacer después)" "n"; then
      prompt_default "Proveedor (scaleway | openai-compat)" "scaleway" AI_PROVIDER
      if [ "$AI_PROVIDER" = "openai-compat" ]; then
        prompt_default "URL base compatible con OpenAI" "http://host.docker.internal:11434/v1" AI_BASE_URL
      fi
      prompt_default "Modelo (Enter = el recomendado)" "" AI_MODEL
      read -r -s -p "  Clave de API (puede ir vacía con openai-compat local): " AI_API_KEY; echo ""
    fi
    info "Generando contraseñas y claves únicas (17 bases de datos, AES-256, OIDC, LiveKit)..."
    escribir_env "$perfiles"
    ok "Creado ${BOLD}deploy/compose/.env${RESET} (permisos 0600, ignorado por Git)."
  fi

  if [ "$ONLY_CONFIG" -eq 1 ]; then
    echo ""
    ok "Configuración lista. Para arrancar: ${BOLD}./sytue-deploy${RESET} (o ${BOLD}make dev-up && make dev-seed${RESET})."
    exit 0
  fi

  # --- Paso 5: arranque ------------------------------------------------------
  step "Paso 5 de 5 · Construcción y arranque"
  generar_certificados
  info "Construyendo las imágenes. La primera vez tarda (≈15-40 min según el equipo); después es incremental."
  DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 dc build
  info "Arrancando contenedores..."
  dc up -d --remove-orphans
  info "Esperando a Sytue ID..."
  local t=0
  until [ "$(docker inspect -f '{{.State.Health.Status}}' "$(dc ps -q id)" 2>/dev/null)" = "healthy" ]; do
    t=$((t + 5)); [ "$t" -lt 300 ] || die "Sytue ID no arranca. Revisa: ${BOLD}make dev-logs SVC=id${RESET}"
    sleep 5
  done
  sembrar_admin || die "No se pudo crear el administrador. Reintenta con ${BOLD}make dev-seed${RESET} y revisa ${BOLD}make dev-logs SVC=id${RESET}."
  info "Esperando a que el resto de servicios estén sanos..."
  local sanos=1
  esperar_salud 900 || sanos=0
  printf "\r%-120s\r" ""
  if [ "$sanos" -eq 1 ]; then
    ok "Todos los servicios están en marcha y sanos."
  fi

  if [ "$SKIP_VERIFY" -eq 0 ] && [ -x "${ROOT_DIR}/scripts/e2e/smoke.sh" ] && [ "$perfiles" = "full" ]; then
    info "Verificación de extremo a extremo (salud, OIDC, enrutado)..."
    if E2E_RETRIES=6 E2E_RETRY_WAIT=5 "${ROOT_DIR}/scripts/e2e/smoke.sh" > "${COMPOSE_DIR}/.verificacion.log" 2>&1; then
      ok "Verificación superada (detalle en deploy/compose/.verificacion.log)."
    else
      sanos=0
      warn "La verificación encontró fallos: ${BOLD}deploy/compose/.verificacion.log${RESET}"
      grep -E '✗|FAIL' "${COMPOSE_DIR}/.verificacion.log" | head -10 || true
    fi
  fi

  resumen_compose
  if [ "$sanos" -eq 0 ]; then
    warn "Algún servicio no está sano todavía: ${BOLD}make dev-ps${RESET} para ver cuál."
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Modo clúster: Kubernetes / Helm (avanzado)
# ---------------------------------------------------------------------------
# Lo que el chart necesita y no despliega él mismo:
#   · las imágenes en TU registro (deploy/helm/publicar-imagenes.sh las construye y sube);
#   · PostgreSQL externo con una base y un rol por servicio (create-databases.sh);
#   · S3 compatible;
#   · los Secrets de cada servicio (apply-secrets.sh, generado aquí);
#   · el propietario inicial en Sytue ID (bootstrap-admin.sh, tras el helm upgrade).

# servicio-del-chart:rol/base de datos
HELM_DBS=(
  "id:sytue_id" "drive:sytue_drive" "docs:sytue_docs" "mail:sytue_mail"
  "calendar:sytue_calendar" "contacts:sytue_contacts" "rooms:sytue_rooms"
  "hub:sytue_hub" "integrations:sytue_integrations" "cloud:sytue_cloud"
  "analytics:sytue_analytics" "syerp:sytue_syerp" "notes:sytue_notes"
  "syphotos:sytue_syphotos" "cast:sytue_cast" "pages:sytue_pages" "bases:sytue_bases"
)
# app del frontend (clave <app>-oidc-client-secret) : client_id en Sytue ID
HELM_CLIENTES=(
  "account:sytue-account" "bases:sytue-bases" "calcus:sytue-calcus"
  "calendar:sytue-calendar" "cast:sytue-cast" "certipdf:sytue-certipdf"
  "cloud-dashboard:sytue-cloud" "console:sytue-console" "contacts:sytue-contacts"
  "diapos:sytue-diapos" "docus:sytue-docus" "drive:sytue-drive" "erp:sytue-syerp"
  "mail:sytue-mail" "notes:sytue-notes" "pages:sytue-pages" "photos:sytue-syphotos"
  "platform:sytue-platform" "portal:sytue-one" "rooms:sytue-chat"
)

instalar_helm() {
  step "Paso 2 de 5 · Clúster, dominio e infraestructura"
  echo "  El modo Helm despliega en TU clúster. Necesitas, además de kubectl y helm:"
  echo "    · un registro de imágenes donde subir la suite (p. ej. ghcr.io/tu-org);"
  echo "    · PostgreSQL 16+ externo y un almacenamiento S3 compatible;"
  echo "    · DNS de *.tu-dominio apuntando al balanceador del clúster."
  [ -n "$DOMAIN" ] || prompt_default "Dominio raíz (ej: suite.miempresa.eu)" "suite.ejemplo.eu" DOMAIN
  prompt_default "Namespace de Kubernetes" "$K8S_NAMESPACE" K8S_NAMESPACE
  prompt_default "Registro de imágenes (donde subirás la suite)" "ghcr.io/mi-organizacion" IMAGE_REGISTRY
  prompt_default "Correo para certificados TLS (Let's Encrypt)" "ops@${DOMAIN}" TLS_EMAIL
  prompt_default "Host de PostgreSQL" "postgres.${DOMAIN}" PG_HOST
  prompt_default "Puerto de PostgreSQL" "$PG_PORT" PG_PORT
  prompt_default "Endpoint S3" "https://s3.${DOMAIN}" S3_ENDPOINT
  prompt_default "Access Key de S3" "sytue-s3-$(rand_hex 8)" S3_ACCESS_KEY
  prompt_secret "Secret Key de S3" S3_SECRET_KEY
  [ -n "$S3_SECRET_KEY" ] || S3_SECRET_KEY="$(rand_hex 24)"
  ok "Dominio ${BOLD}${DOMAIN}${RESET} · namespace ${BOLD}${K8S_NAMESPACE}${RESET} · registro ${BOLD}${IMAGE_REGISTRY}${RESET}"

  step "Paso 3 de 5 · Propietario inicial"
  [ -n "$ORG_SLUG" ] || prompt_default "Organización inicial (slug, minúsculas)" "acme" ORG_SLUG
  [ -n "$ADMIN_EMAIL" ] || prompt_default "Correo del propietario" "admin@${DOMAIN}" ADMIN_EMAIL
  resolver_password_admin

  step "Paso 4 de 5 · Integraciones con terceros"
  if [ "$NON_INTERACTIVE" -eq 0 ] &&
    ! prompt_yes_no "¿Registrar ahora apps OAuth de proveedores (Google, Microsoft, Slack, Zoom…)?" "n"; then
    # La base del gateway se genera igualmente: sin ella el pod de integraciones
    # no arranca. Las apps OAuth se pueden añadir después con --integrations.
    NON_INTERACTIVE=1 asistente_integraciones
    info "Puedes registrar apps OAuth más adelante con ${BOLD}./sytue-deploy --integrations${RESET}."
  else
    asistente_integraciones
  fi

  step "Paso 5 de 5 · Secretos y ficheros del despliegue"
  escribir_helm
  printf "\n${BOLD}Propietario inicial:${RESET} %s en la organización %s\n" "$ADMIN_EMAIL" "$ORG_SLUG"
  if [ "${ADMIN_PASS_GENERATED:-0}" -eq 1 ]; then
    printf "  Contraseña: ${BOLD}%s${RESET} ${DIM}(también en deploy/helm/bootstrap-admin.sh)${RESET}\n" "$ADMIN_PASSWORD"
  fi
  cat <<EOF

$(printf "${BOLD}Para desplegar en tu clúster, en este orden:${RESET}")
  1) bash deploy/helm/publicar-imagenes.sh ${IMAGE_REGISTRY} ${DOMAIN}   # construye y sube las imágenes
  2) bash deploy/helm/create-databases.sh                       # roles y bases en tu PostgreSQL
  3) bash deploy/helm/apply-secrets.sh && bash deploy/helm/apply-integrations.sh
  4) bash scripts/prepare-helm-vendor.sh && helm dependency build deploy/helm/sytue-one
  5) helm upgrade --install sytue-one deploy/helm/sytue-one -n ${K8S_NAMESPACE} --create-namespace \\
       -f deploy/helm/sytue-one/values.yaml -f deploy/helm/values-custom.yaml -f deploy/helm/values-integrations.yaml
  6) bash deploy/helm/bootstrap-admin.sh                        # crea el propietario inicial
  7) Entra en https://one.${DOMAIN} y activa la verificación en dos pasos en https://id.${DOMAIN}/account
EOF
}

escribir_helm() {
  umask 077
  local VALUES="${HELM_DIR}/values-custom.yaml" SECRETS="${HELM_DIR}/apply-secrets.sh"
  local DBSQL="${HELM_DIR}/create-databases.sh" BOOT="${HELM_DIR}/bootstrap-admin.sh"
  local LK_KEY LK_SECRET par svc db app cliente
  local -A DBPASS=()
  LK_KEY="LK$(rand_hex 8)"
  LK_SECRET="$(rand_hex 32)"

  cat > "$VALUES" <<EOF
# ===========================================================================
# Sytue Suite — Overlay de Helm generado por ./sytue-deploy ($(date -u +"%Y-%m-%dT%H:%M:%SZ"))
# Uso: helm upgrade --install sytue-one deploy/helm/sytue-one -n ${K8S_NAMESPACE} \\
#        -f deploy/helm/sytue-one/values.yaml -f deploy/helm/values-custom.yaml \\
#        -f deploy/helm/values-integrations.yaml
# ===========================================================================
global:
  env: prod
  baseDomain: "${DOMAIN}"
  appsDomain: "apps.${DOMAIN}"
  previewDomain: "preview.${DOMAIN}"
  issuerURL: "https://id.${DOMAIN}"
  imageRegistry: "${IMAGE_REGISTRY}"
  certIssuer: "sytue-letsencrypt-prod"
  acmeEmail: "${TLS_EMAIL}"
  postgresql:
    host: "${PG_HOST}"
    port: ${PG_PORT}
    sslMode: "require"
  objectStorage:
    endpoint: "${S3_ENDPOINT}"
    region: "eu-central-1"
  networkPolicy:
    # Redes desde las que tu balanceador llega a Traefik. 0.0.0.0/0 = cualquiera:
    # acótalo a la red de tu proveedor cuando la conozcas.
    loadBalancerSourceCIDRs: ["0.0.0.0/0"]
livekit:
  webhook:
    apiKey: "${LK_KEY}"
EOF
  chmod 600 "$VALUES"
  ok "deploy/helm/values-custom.yaml"

  {
    cat <<EOF
#!/usr/bin/env bash
# Generado por ./sytue-deploy: crea los Secrets de Sytue Suite en '${K8S_NAMESPACE}'.
# Contiene secretos: NO lo subas a Git. Idempotente (kubectl apply).
set -euo pipefail
NS="${K8S_NAMESPACE}"
kubectl get namespace "\$NS" >/dev/null 2>&1 || kubectl create namespace "\$NS"
s() { local n="\$1"; shift; kubectl -n "\$NS" create secret generic "\$n" "\$@" --dry-run=client -o yaml | kubectl apply -f - >/dev/null; echo "✓ \$n"; }

s sytue-postgresql --from-literal=host="${PG_HOST}" --from-literal=port="${PG_PORT}"
s sytue-object-storage --from-literal=endpoint="${S3_ENDPOINT}" \\
  --from-literal=access-key="${S3_ACCESS_KEY}" --from-literal=secret-key="${S3_SECRET_KEY}"
s sytue-id --from-literal=key-encryption-key="$(rand_hex 32)" --from-literal=internal-secret="$(rand_hex 32)"
s sytue-livekit-keys --from-literal=api-key="${LK_KEY}" --from-literal=api-secret="${LK_SECRET}" \\
  --from-literal=keys.yaml="${LK_KEY}: ${LK_SECRET}"
s sytue-analytics --from-literal=key-encryption-key="$(rand_b64 32)"
s sytue-docs --from-literal=secret-enc-key="$(rand_b64 32)"
s sytue-pages --from-literal=secret-enc-key="$(rand_b64 32)"
s sytue-syerp --from-literal=secret-enc-key="$(rand_b64 32)"
s sytue-rooms --from-literal=key-encryption-key="$(rand_b64 32)"
s sytue-bases --from-literal=altcha-secret="$(rand_hex 32)"
s sytue-cast --from-literal=cast-internal-secret="$(rand_hex 32)" --from-literal=media-signing-key="$(rand_hex 32)"
EOF
    # Una base y un rol por servicio. La contraseña de cada rol la fija create-databases.sh.
    for par in "${HELM_DBS[@]}"; do
      IFS=':' read -r svc db <<< "$par"
      DBPASS[$svc]="$(rand_hex 24)"
      local dsn="postgres://${db}:${DBPASS[$svc]}@${PG_HOST}:${PG_PORT}/${db}?sslmode=require"
      printf 's sytue-%s-db --from-literal=dsn="%s" --from-literal=dsn-direct="%s"\n' "$svc" "$dsn" "$dsn"
    done
    # Sytue Cloud: los tres componentes comparten base, S3 y clave de cifrado.
    local cloud_dsn="postgres://sytue_cloud:${DBPASS[cloud]}@${PG_HOST}:${PG_PORT}/sytue_cloud?sslmode=require"
    local cloud_key; cloud_key="$(rand_b64 32)"
    for svc in cloud-api cloud-builder cloud-controller; do
      printf 's sytue-%s --from-literal=database-url="%s" --from-literal=s3-access-key="%s" --from-literal=s3-secret-key="%s" --from-literal=secret-enc-key="%s"\n' \
        "$svc" "$cloud_dsn" "$S3_ACCESS_KEY" "$S3_SECRET_KEY" "$cloud_key"
    done
    # Clientes OIDC de los frontends: el MISMO secreto en el BFF de cada app y en
    # Sytue ID (sytue-id-client-secrets, que id reconcilia al arrancar).
    local bff=(--from-literal=cookie-secret="$(rand_hex 32)") idc=()
    for par in "${HELM_CLIENTES[@]}"; do
      IFS=':' read -r app cliente <<< "$par"
      local sec; sec="$(rand_hex 32)"
      bff+=(--from-literal="${app}-oidc-client-secret=${sec}")
      idc+=(--from-literal="${cliente}=${sec}")
    done
    printf 's sytue-frontend-bff'; printf ' %q' "${bff[@]}"; printf '\n'
    cat <<'EOF'
# sytue-id-client-secrets ya puede tener el cliente del gateway (apply-integrations.sh):
# se fusiona en vez de reemplazarse.
kubectl -n "$NS" get secret sytue-id-client-secrets >/dev/null 2>&1 || kubectl -n "$NS" create secret generic sytue-id-client-secrets >/dev/null
EOF
    local c
    for c in "${idc[@]}"; do
      local kv="${c#--from-literal=}"
      printf 'kubectl -n "$NS" patch secret sytue-id-client-secrets --type merge -p %q >/dev/null\n' "{\"stringData\":{\"${kv%%=*}\":\"${kv#*=}\"}}"
    done
    cat <<'EOF'
echo "✓ sytue-id-client-secrets"
# Certificado del correo (SMTP/IMAP). Si no tienes uno comodín propio, se crea uno
# autofirmado para que Mail arranque; sustitúyelo después por el de tu dominio.
if ! kubectl -n "$NS" get secret tls-wildcard-sytue-eu >/dev/null 2>&1; then
  t="$(mktemp -d)"
EOF
    printf '  openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=*.%s" -keyout "$t/k" -out "$t/c" >/dev/null 2>&1\n' "$DOMAIN"
    cat <<'EOF'
  kubectl -n "$NS" create secret tls tls-wildcard-sytue-eu --cert="$t/c" --key="$t/k" >/dev/null
  rm -rf "$t"; echo "✓ tls-wildcard-sytue-eu (autofirmado: sustitúyelo por el de tu dominio)"
fi
echo "Secrets de Sytue Suite aplicados en el namespace '$NS'."
EOF
  } > "$SECRETS"
  chmod 700 "$SECRETS"
  ok "deploy/helm/apply-secrets.sh"

  {
    cat <<EOF
#!/usr/bin/env bash
# Generado por ./sytue-deploy: crea en tu PostgreSQL un rol y una base por servicio.
# Ejecútalo con un usuario con CREATEROLE y CREATEDB. Idempotente. Contiene secretos.
#   PGUSER=postgres PGPASSWORD=… bash deploy/helm/create-databases.sh
set -euo pipefail
export PGHOST="\${PGHOST:-${PG_HOST}}" PGPORT="\${PGPORT:-${PG_PORT}}" PGSSLMODE="\${PGSSLMODE:-require}"
crear() {
  psql -v ON_ERROR_STOP=1 -d "\${PGDATABASE:-postgres}" <<SQL
DO \\\$\\\$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '\$1') THEN
    CREATE ROLE "\$1" LOGIN CREATEROLE PASSWORD '\$2';
  ELSE
    ALTER ROLE "\$1" PASSWORD '\$2';
  END IF;
END \\\$\\\$;
SELECT 'CREATE DATABASE "\$1" OWNER "\$1"' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '\$1')\\gexec
SQL
  echo "✓ \$1"
}
EOF
    for par in "${HELM_DBS[@]}"; do
      IFS=':' read -r svc db <<< "$par"
      printf 'crear %s %s\n' "$db" "${DBPASS[$svc]}"
    done
  } > "$DBSQL"
  chmod 700 "$DBSQL"
  ok "deploy/helm/create-databases.sh"

  cat > "$BOOT" <<EOF
#!/usr/bin/env bash
# Generado por ./sytue-deploy: crea (o reafirma) el propietario inicial de Sytue ID
# con un Job de una sola ejecución, con la misma imagen que el Deployment de id.
# Ejecútalo DESPUÉS del helm upgrade. Idempotente. Contiene la contraseña inicial.
set -euo pipefail
NS="${K8S_NAMESPACE}"
IMG="\$(kubectl -n "\$NS" get deployment sytue-one-id -o jsonpath='{.spec.template.spec.containers[0].image}')"
kubectl -n "\$NS" create secret generic sytue-id-bootstrap \\
  --from-literal=owner-password='${ADMIN_PASSWORD}' --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl -n "\$NS" delete job sytue-bootstrap-owner --ignore-not-found --wait=true >/dev/null
kubectl -n "\$NS" apply -f - >/dev/null <<YAML
apiVersion: batch/v1
kind: Job
metadata:
  name: sytue-bootstrap-owner
  labels: { app.kubernetes.io/part-of: sytue-one, app.kubernetes.io/component: bootstrap-owner }
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels: { app.kubernetes.io/part-of: sytue-one, app.kubernetes.io/component: bootstrap-owner }
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext: { runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532 }
      containers:
        - name: bootstrap
          image: \$IMG
          args: ["bootstrap-owner"]
          env:
            - { name: SYTUE_ID_DATABASE_DSN, valueFrom: { secretKeyRef: { name: sytue-id-db, key: dsn-direct } } }
            - { name: SYTUE_ID_BOOTSTRAP_PASSWORD, valueFrom: { secretKeyRef: { name: sytue-id-bootstrap, key: owner-password } } }
            - { name: SYTUE_ID_BOOTSTRAP_EMAIL, value: "${ADMIN_EMAIL}" }
            - { name: SYTUE_ID_BOOTSTRAP_ORG_SLUG, value: "${ORG_SLUG}" }
            - { name: SYTUE_ID_BOOTSTRAP_ORG_NAME, value: "${ORG_SLUG}" }
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
---
# La política base del chart deniega por defecto: el Job solo necesita DNS y PostgreSQL.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: sytue-bootstrap-owner
spec:
  podSelector: { matchLabels: { app.kubernetes.io/component: bootstrap-owner } }
  policyTypes: ["Egress"]
  egress:
    - ports: [ { protocol: UDP, port: 53 }, { protocol: TCP, port: 53 }, { protocol: TCP, port: ${PG_PORT} } ]
YAML
kubectl -n "\$NS" wait --for=condition=complete job/sytue-bootstrap-owner --timeout=180s
kubectl -n "\$NS" logs job/sytue-bootstrap-owner
EOF
  chmod 700 "$BOOT"
  ok "deploy/helm/bootstrap-admin.sh"
}

# ---------------------------------------------------------------------------
# Inicio
# ---------------------------------------------------------------------------
printf "${BOLD}${CYAN}"
cat <<'BANNER'
  ____        _               ____        _ _
 / ___| _   _| |_ _   _  ___ / ___| _   _(_) |_ ___
 \___ \| | | | __| | | |/ _ \\___ \| | | | | __/ _ \
  ___) | |_| | |_| |_| |  __/ ___) | |_| | | ||  __/
 |____/ \__, |\__|\__,_|\___||____/ \__,_|_|\__\___|
        |___/
BANNER
printf "${RESET}${BOLD}Instalador paso a paso (Apache-2.0)${RESET}\n"

check_cmd openssl || die "Se necesita 'openssl' para generar las claves criptográficas."

if [ "$INTEGRATIONS_ONLY" -eq 1 ]; then
  modo_integraciones
fi

step "Paso 1 de 5 · Dónde instalar"
if [ -z "$MODE" ]; then
  if [ "$NON_INTERACTIVE" -eq 1 ] || [ "$DO_RESET" -eq 1 ]; then
    MODE="compose"
  else
    echo "    1) En este equipo con Docker  — recomendado: prueba o servidor único, en https://*.${LOCAL_DOMAIN}"
    echo "    2) En un clúster Kubernetes   — avanzado: tu dominio, tu registro, tu PostgreSQL y tu S3"
    eleccion=""
    prompt_default "Opción" "1" eleccion
    case "$eleccion" in
      2|helm|k8s) MODE="helm" ;;
      *)          MODE="compose" ;;
    esac
  fi
fi
ok "Modo: ${BOLD}${MODE}${RESET}"

if [ "$MODE" = "compose" ]; then
  instalar_compose
else
  instalar_helm
fi
